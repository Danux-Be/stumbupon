<%- include('../partials/header') %>

<div class="admin-page">
  <h1><%= t('admin_flagged_title') %></h1>
  <a href="/admin" class="btn btn-secondary" style="margin-bottom:1.5rem">← <%= t('admin_back') %></a>

  <% if (!sites.length) { %>
    <p class="alert alert-success"><%= t('admin_flagged_empty') %></p>
  <% } else { %>
  <div class="admin-list">
    <% for (const site of sites) { %>
    <div class="admin-card">
      <div class="admin-card__header">
        <div>
          <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer" class="admin-card__url">
            <%= site.url.replace(/^https?:\/\//, '').slice(0, 70) %>
          </a>
          <div class="admin-card__title"><%= site.title %></div>
        </div>
        <span class="risk-badge risk-badge--high"><%= site.flag_reason %></span>
      </div>

      <div class="admin-card__meta">
        <span>Approuvé : <%= new Date(site.approved_at).toLocaleDateString() %></span>
        <span>Vérifié : <%= site.last_checked_at ? new Date(site.last_checked_at).toLocaleDateString() : '—' %></span>
      </div>

      <div class="admin-card__actions" style="flex-wrap:wrap;gap:.5rem">
        <form method="POST" action="/admin/flagged/<%= site.id %>/restore" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn-approve"><%= t('admin_flagged_restore') %></button>
        </form>
        <form method="POST" action="/admin/flagged/<%= site.id %>/reject" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn btn-reject"><%= t('admin_dismiss') %></button>
        </form>
        <form method="POST" action="/admin/site/<%= site.id %>/language" style="display:inline-flex;align-items:center;gap:.4rem">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="_redirect" value="/admin/flagged" />
          <label style="font-size:.82rem;color:var(--color-text-muted);white-space:nowrap"><%= t('admin_site_lang') %> :</label>
          <select name="language" style="font-size:.82rem;padding:.25rem .4rem;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:var(--color-surface)">
            <option value="">—</option>
            <% ['ar','da','de','el','en','es','fr','it','ja','nl','pl','pt','ru','zh'].forEach(function(lc) { %>
              <option value="<%= lc %>" <%= site.language === lc ? 'selected' : '' %>><%= lc %></option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-secondary" style="padding:.25rem .6rem;font-size:.82rem">✓</button>
        </form>
      </div>
    </div>
    <% } %>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
