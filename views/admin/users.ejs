<%- include('../partials/header') %>

<div class="admin-page">
  <h1><%= t('admin_users_title') %></h1>
  <a href="/admin" class="btn btn-secondary" style="margin-bottom:1.5rem"><span class="mdi mdi-arrow-left"></span> <%= t('admin_back') %></a>

  <% if (!users.length) { %>
    <p class="alert alert-info"><%= t('admin_users_empty') %></p>
  <% } else { %>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th><%= t('admin_users_col_user') %></th>
          <th><%= t('admin_users_col_joined') %></th>
          <th><%= t('admin_users_col_votes') %></th>
          <th>Pages vues</th>
          <th><%= t('admin_users_col_actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% for (const u of users) { %>
        <tr class="<%= u.is_banned ? 'admin-table__row--banned' : '' %>">
          <td>
            <div style="display:flex;align-items:center;gap:0.5rem">
              <% if (u.avatar) { %>
                <img src="/avatars/<%= u.avatar %>" alt="" style="width:28px;height:28px;border-radius:50%;object-fit:cover;flex-shrink:0">
              <% } else { %>
                <span class="mdi mdi-account-circle" style="font-size:28px;color:var(--muted);flex-shrink:0"></span>
              <% } %>
              <div>
                <div style="display:flex;align-items:center;gap:0.3rem;flex-wrap:wrap">
                  <strong><%= u.username %></strong>
                  <% if (u.is_admin) { %><span class="user-badge user-badge--admin">admin</span><% } %>
                  <% if (u.is_curator) { %><span class="user-badge user-badge--curator">curateur</span><% } %>
                  <% if (u.is_banned) { %><span class="user-badge user-badge--banned"><%= t('admin_badge_banned') %></span><% } %>
                  <% if (!u.email_verified) { %><span class="user-badge user-badge--unverified"><%= t('admin_badge_unverified') %></span><% } %>
                </div>
                <span class="admin-table__muted" style="font-size:0.78rem"><%= u.email %></span>
              </div>
            </div>
          </td>
          <td class="admin-table__muted"><%= new Date(u.created_at).toLocaleDateString() %></td>
          <td><%= u.vote_count %></td>
          <td><%= u.view_count %></td>
          <td class="admin-table__actions">
            <% if (u.id !== currentUserId) { %>
              <% if (u.is_banned) { %>
                <form method="POST" action="/admin/users/<%= u.id %>/unban" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-approve btn-sm"><%= t('admin_unban') %></button>
                </form>
              <% } else { %>
                <form method="POST" action="/admin/users/<%= u.id %>/ban" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-reject btn-sm"><%= t('admin_ban') %></button>
                </form>
              <% } %>
              <% if (u.is_admin) { %>
                <form method="POST" action="/admin/users/<%= u.id %>/demote" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-secondary btn-sm"><%= t('admin_demote') %></button>
                </form>
              <% } else { %>
                <form method="POST" action="/admin/users/<%= u.id %>/promote" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-secondary btn-sm"><%= t('admin_promote') %></button>
                </form>
              <% } %>
              <% if (u.is_curator) { %>
                <form method="POST" action="/admin/users/<%= u.id %>/unmake-curator" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-ghost btn-sm">- Curateur</button>
                </form>
              <% } else if (!u.is_admin) { %>
                <form method="POST" action="/admin/users/<%= u.id %>/make-curator" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-ghost btn-sm">+ Curateur</button>
                </form>
              <% } %>
              <form method="POST" action="/admin/users/<%= u.id %>/delete" style="display:inline"
                    onsubmit="return confirm('Supprimer le compte de <%= u.username %> ?\nCette action est irréversible.')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn btn-reject btn-sm" title="Supprimer le compte">
                  <span class="mdi mdi-delete"></span>
                </button>
              </form>
            <% } else { %>
              <span class="admin-table__muted">(vous)</span>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
