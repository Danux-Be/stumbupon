<%- include('../partials/header') %>

<div class="admin-page">
  <h1><%= t('admin_title') %></h1>

  <div class="admin-stats">
    <div class="stat-card">
      <span class="stat-value"><%= stats.users %></span>
      <span class="stat-label"><%= t('admin_stat_users') %></span>
    </div>
    <div class="stat-card <%= stats.banned > 0 ? 'stat-card--alert' : '' %>">
      <span class="stat-value"><%= stats.banned %></span>
      <span class="stat-label"><%= t('admin_stat_banned') %></span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.sites %></span>
      <span class="stat-label"><%= t('admin_stat_sites') %></span>
    </div>
    <div class="stat-card <%= stats.pending > 0 ? 'stat-card--alert' : '' %>">
      <span class="stat-value"><%= stats.pending %></span>
      <span class="stat-label"><%= t('admin_stat_pending') %></span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.votes %></span>
      <span class="stat-label"><%= t('admin_stat_votes') %></span>
    </div>
    <div class="stat-card <%= stats.reports > 0 ? 'stat-card--alert' : '' %>">
      <span class="stat-value"><%= stats.reports %></span>
      <span class="stat-label"><%= t('admin_stat_reports') %></span>
    </div>
    <div class="stat-card <%= stats.quarantine > 0 ? 'stat-card--alert' : '' %>">
      <span class="stat-value"><%= stats.quarantine %></span>
      <span class="stat-label"><%= t('admin_stat_quarantine') %></span>
    </div>
    <div class="stat-card <%= stats.optout > 0 ? 'stat-card--alert' : '' %>">
      <span class="stat-value"><%= stats.optout %></span>
      <span class="stat-label"><%= t('admin_stat_optout') %></span>
    </div>
    <div class="stat-card <%= stats.flagged > 0 ? 'stat-card--alert' : '' %>">
      <span class="stat-value"><%= stats.flagged %></span>
      <span class="stat-label"><%= t('admin_stat_flagged') %></span>
    </div>
    <div class="stat-card <%= stats.referers > 0 ? 'stat-card--alert' : '' %>">
      <span class="stat-value"><%= stats.referers %></span>
      <span class="stat-label"><%= t('admin_stat_referers') %></span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.comments %></span>
      <span class="stat-label">Commentaires</span>
    </div>
  </div>

  <div class="admin-nav">
    <a href="/admin/pending" class="btn btn-primary">
      <%= t('admin_pending_title') %><% if (stats.pending > 0) { %> (<%= stats.pending %>)<% } %>
    </a>
    <a href="/admin/reports" class="btn <%= stats.reports > 0 ? 'btn-primary' : 'btn-secondary' %>">
      <%= t('admin_reports_title') %><% if (stats.reports > 0) { %> (<%= stats.reports %>)<% } %>
    </a>
    <a href="/admin/optout" class="btn <%= stats.optout > 0 ? 'btn-primary' : 'btn-secondary' %>">
      <%= t('admin_optout_title') %><% if (stats.optout > 0) { %> (<%= stats.optout %>)<% } %>
    </a>
    <a href="/admin/flagged" class="btn <%= stats.flagged > 0 ? 'btn-primary' : 'btn-secondary' %>">
      <span class="mdi mdi-alert-outline"></span> <%= t('admin_flagged_title') %><% if (stats.flagged > 0) { %> (<%= stats.flagged %>)<% } %>
    </a>
    <a href="/admin/referers" class="btn <%= stats.referers > 0 ? 'btn-primary' : 'btn-secondary' %>">
      <span class="mdi mdi-link-variant"></span> <%= t('admin_referers_title') %><% if (stats.referers > 0) { %> (<%= stats.referers %>)<% } %>
    </a>
    <a href="/admin/comments" class="btn btn-secondary"><span class="mdi mdi-comment-outline"></span> Commentaires<% if (stats.comments > 0) { %> (<%= stats.comments %>)<% } %></a>
    <a href="/admin/users" class="btn btn-secondary"><span class="mdi mdi-account-group-outline"></span> <%= t('admin_users_title') %></a>
    <a href="/admin/bot" class="btn btn-secondary"><span class="mdi mdi-robot-outline"></span> <%= t('admin_bot_title') %></a>
    <a href="/admin/config" class="btn btn-secondary"><span class="mdi mdi-cog-outline"></span> Configuration</a>
  </div>

  <% if (stats.noEmbed > 0) { %>
  <div class="admin-bulk-bar" style="margin-top:1.5rem">
    <span class="admin-bulk-info">
      <strong><%= stats.noEmbed %></strong> site<%= stats.noEmbed > 1 ? 's' : '' %> approuvés non-embeddables (<code>can_embed = 0</code>)
    </span>
    <form method="POST" action="/admin/sites/delete-no-embed"
          onsubmit="return confirm('Supprimer les <%= stats.noEmbed %> sites non-embeddables ? Irréversible.')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn-reject btn-sm">🗑️ Supprimer tous</button>
    </form>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
