<%- include('partials/header', { title: t('settings_title') }) %>

<div class="settings-page">
  <h1><%= t('settings_title') %></h1>

  <% if (success === 'interests') { %>
    <p class="alert alert-success"><%= t('success_interests') %></p>
  <% } else if (success === 'password') { %>
    <p class="alert alert-success"><%= t('success_password') %></p>
  <% } else if (success === 'lang') { %>
    <p class="alert alert-success"><%= t('success_lang') %></p>
  <% } else if (error === 'interests-min') { %>
    <p class="alert alert-error"><%= t('error_interests_min') %></p>
  <% } else if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <!-- Centres d'intérêt -->
  <section class="settings-section">
    <h2><%= t('settings_interests_title') %></h2>
    <p><%= t('settings_interests_desc') %></p>

    <form method="POST" action="/settings/interests" x-data="{ count: <%= selected.length %> }">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <p class="interests-count"
         x-init="$el.textContent = '<%= t('interests_count', { count: selected.length }) %>'"
         x-text="'<%= t('interests_count', {count: 0}) %>'.replace('0', count)">
      </p>

      <div class="categories-grid categories-grid--compact">
        <% for (const cat of categories) { %>
          <label class="category-card" x-on:click="count = $el.querySelector('input').checked ? count - 1 : count + 1">
            <input
              type="checkbox"
              name="categories"
              value="<%= cat.id %>"
              <%= selected.includes(cat.id) ? 'checked' : '' %>
            />
            <span class="category-emoji"><%= cat.emoji %></span>
            <span class="category-name"><%= cat.localName %></span>
          </label>
        <% } %>
      </div>

      <button type="submit" class="btn btn-primary" x-bind:disabled="count < 3">
        <%= t('settings_interests_submit') %>
      </button>
    </form>
  </section>

  <!-- Langue -->
  <section class="settings-section">
    <h2><%= t('settings_lang_title') %></h2>
    <p><%= t('settings_lang_desc') %></p>
    <div class="lang-buttons">
      <% for (const [code, label] of Object.entries(langLabels)) { %>
        <a href="/lang/<%= code %>"
           class="btn <%= currentLang === code ? 'btn-primary' : 'btn-secondary' %>">
          <%= label %>
        </a>
      <% } %>
    </div>
  </section>

  <!-- Mot de passe -->
  <section class="settings-section">
    <h2><%= t('settings_password_title') %></h2>

    <form method="POST" action="/settings/password" class="form-card form-card--inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="form-group">
        <label for="current"><%= t('settings_password_current') %></label>
        <input type="password" id="current" name="current" required autocomplete="current-password" />
      </div>
      <div class="form-group">
        <label for="newpass"><%= t('settings_password_new') %></label>
        <input type="password" id="newpass" name="newpass" required minlength="8" autocomplete="new-password" />
        <span class="form-hint"><%= t('settings_password_hint') %></span>
      </div>
      <div class="form-group">
        <label for="confirm"><%= t('settings_password_confirm') %></label>
        <input type="password" id="confirm" name="confirm" required minlength="8" autocomplete="new-password" />
      </div>
      <button type="submit" class="btn btn-primary"><%= t('settings_password_submit') %></button>
    </form>
  </section>
</div>

<%- include('partials/footer') %>
