<%- include('partials/header', { title: t('settings_title') }) %>

<div class="settings-page">
  <h1><%= t('settings_title') %></h1>

  <% if (success === 'interests') { %>
    <p class="alert alert-success"><%= t('success_interests') %></p>
  <% } else if (success === 'password') { %>
    <p class="alert alert-success"><%= t('success_password') %></p>
  <% } else if (success === 'lang') { %>
    <p class="alert alert-success"><%= t('success_lang') %></p>
  <% } else if (success === 'content_langs') { %>
    <p class="alert alert-success"><%= t('success_content_langs') %></p>
  <% } else if (success === 'digest') { %>
    <p class="alert alert-success"><%= t('success_digest') %></p>
  <% } else if (success === 'avatar') { %>
    <p class="alert alert-success"><%= t('success_avatar') %></p>
  <% } else if (success === 'username') { %>
    <p class="alert alert-success"><%= t('success_username') %></p>
  <% } else if (success === 'email_pending') { %>
    <p class="alert alert-success"><%= t('success_email_pending') %></p>
  <% } else if (success === 'email_changed') { %>
    <p class="alert alert-success"><%= t('success_email_changed') %></p>
  <% } else if (error === 'interests-min') { %>
    <p class="alert alert-error"><%= t('error_interests_min') %></p>
  <% } else if (error === 'delete_password_wrong') { %>
    <p class="alert alert-error"><%= t('error_delete_password_wrong') %></p>
  <% } else if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <!-- Navigation d'ancres -->
  <nav class="settings-nav" aria-label="<%= t('settings_title') %>">
    <a href="#decouverte" class="settings-nav__link"><span class="mdi mdi-target"></span> <%= t('settings_group_discovery') %></a>
    <a href="#interface"  class="settings-nav__link"><span class="mdi mdi-palette-outline"></span> <%= t('settings_group_interface') %></a>
    <a href="#notifications" class="settings-nav__link"><span class="mdi mdi-email-outline"></span> <%= t('settings_group_notifications') %></a>
    <a href="#compte"     class="settings-nav__link"><span class="mdi mdi-shield-account-outline"></span> <%= t('settings_group_account') %></a>
    <a href="#succes"     class="settings-nav__link"><span class="mdi mdi-trophy-outline"></span> <%= t('settings_group_achievements') %></a>
  </nav>

  <!-- ── Découverte ──────────────────────────────────────────────────────── -->
  <div id="decouverte" class="settings-group">
    <p class="settings-group__title"><span class="mdi mdi-target"></span> <%= t('settings_group_discovery') %></p>

    <!-- Centres d'intérêt -->
    <section class="settings-section">
      <h2><%= t('settings_interests_title') %></h2>
      <p><%= t('settings_interests_desc') %></p>

      <form method="POST" action="/settings/interests" id="settings-interests-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <p class="interests-count">
          <span id="settings-interests-count"><%= selected.length %></span>&nbsp;<%- t('interests_count', { count: '' }).trim() %>
        </p>

        <div class="categories-grid categories-grid--compact">
          <% for (const cat of categories) { %>
            <label class="category-card">
              <input
                type="checkbox"
                name="categories"
                value="<%= cat.id %>"
                <%= selected.includes(cat.id) ? 'checked' : '' %>
              />
              <span class="category-emoji"><%= cat.emoji %></span>
              <span class="category-name"><%= cat.localName %></span>
            </label>
          <% } %>
        </div>

        <button type="submit" class="btn btn-primary" id="settings-interests-submit"
                <%= selected.length < 3 ? 'disabled' : '' %>>
          <%= t('settings_interests_submit') %>
        </button>
      </form>

      <script>
        (function () {
          var form    = document.getElementById('settings-interests-form');
          var counter = document.getElementById('settings-interests-count');
          var submit  = document.getElementById('settings-interests-submit');
          if (!form || !counter || !submit) return;
          function recount() {
            var n = form.querySelectorAll('input[type="checkbox"]:checked').length;
            counter.textContent = n;
            submit.disabled = n < 3;
          }
          form.addEventListener('change', function (e) {
            if (e.target.type === 'checkbox') recount();
          });
        })();
      </script>
    </section>

    <!-- Langues du contenu -->
    <section class="settings-section">
      <h2><%= t('settings_content_langs_title') %></h2>
      <p><%= t('settings_content_langs_desc') %></p>
      <form method="POST" action="/settings/content-languages">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="lang-checkboxes">
          <% for (const code of allLangs) { %>
            <label class="lang-check-label">
              <input type="checkbox" name="langs" value="<%= code %>"
                     <%= contentLangs.includes(code) ? 'checked' : '' %> />
              <%= t('lang_' + code) %>
            </label>
          <% } %>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:0.8rem">
          <%= t('settings_content_langs_submit') %>
        </button>
      </form>
    </section>
    <!-- Vidéos YouTube -->
    <section class="settings-section">
      <h2><%= t('settings_videos_title') %></h2>
      <p><%= t('settings_videos_desc') %></p>
      <form method="POST" action="/settings/videos">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label class="toggle-label">
          <input type="hidden" name="videos" value="0" />
          <input type="checkbox" name="videos" value="1"
                 onchange="this.form.submit()"
                 <%= includeVideos ? 'checked' : '' %> />
          <%= t('settings_videos_label') %>
        </label>
      </form>
    </section>
  </div>

  <!-- ── Interface ───────────────────────────────────────────────────────── -->
  <div id="interface" class="settings-group">
    <p class="settings-group__title"><span class="mdi mdi-palette-outline"></span> <%= t('settings_group_interface') %></p>

    <!-- Langue de l'interface -->
    <section class="settings-section">
      <h2><%= t('settings_lang_title') %></h2>
      <p><%= t('settings_lang_desc') %></p>
      <div class="lang-buttons">
        <% for (const [code, label] of Object.entries(langLabels)) { %>
          <a href="/lang/<%= code %>"
             class="btn <%= currentLang === code ? 'btn-primary' : 'btn-secondary' %>">
            <%= label %>
          </a>
        <% } %>
      </div>
    </section>

    <!-- Position de la barre -->
    <section class="settings-section">
      <h2><%= t('settings_bar_title') %></h2>
      <p><%= t('settings_bar_desc') %></p>
      <div class="settings-btn-group">
        <button type="button" id="bar-pos-top"    class="btn btn-secondary"><span class="mdi mdi-arrow-up"></span> <%= t('settings_bar_top') %></button>
        <button type="button" id="bar-pos-bottom" class="btn btn-secondary"><span class="mdi mdi-arrow-down"></span> <%= t('settings_bar_bottom') %></button>
      </div>
      <script>
        (function() {
          var btnTop    = document.getElementById('bar-pos-top');
          var btnBottom = document.getElementById('bar-pos-bottom');
          function update() {
            var pos = localStorage.getItem('sc-bar-pos') || 'top';
            btnTop.className    = 'btn ' + (pos === 'top'    ? 'btn-primary' : 'btn-secondary');
            btnBottom.className = 'btn ' + (pos === 'bottom' ? 'btn-primary' : 'btn-secondary');
          }
          update();
          btnTop.addEventListener('click', function() {
            localStorage.setItem('sc-bar-pos', 'top');
            update();
          });
          btnBottom.addEventListener('click', function() {
            localStorage.setItem('sc-bar-pos', 'bottom');
            update();
          });
        })();
      </script>
    </section>

    <!-- Animations -->
    <section class="settings-section">
      <h2><%= t('settings_anim_title') %></h2>
      <p><%= t('settings_anim_desc') %></p>
      <label class="lang-check-label" style="margin-top:0.8rem">
        <input type="checkbox" id="anim-toggle" />
        <%= t('settings_anim_label') %>
      </label>
      <br/>
      <button type="button" id="anim-save" class="btn btn-primary" style="margin-top:0.8rem">
        <%= t('settings_save') %>
      </button>
      <script>
        (function() {
          var toggle = document.getElementById('anim-toggle');
          var btn    = document.getElementById('anim-save');
          toggle.checked = localStorage.getItem('sc-animations') === '1';
          btn.addEventListener('click', function() {
            localStorage.setItem('sc-animations', toggle.checked ? '1' : '0');
            btn.textContent = '✓';
            setTimeout(function() { btn.textContent = '<%= t('settings_save') %>'; }, 1500);
          });
        })();
      </script>
    </section>
  </div>

  <!-- ── Notifications ───────────────────────────────────────────────────── -->
  <div id="notifications" class="settings-group">
    <p class="settings-group__title"><span class="mdi mdi-email-outline"></span> <%= t('settings_group_notifications') %></p>

    <!-- Digest hebdomadaire -->
    <section class="settings-section">
      <h2><%= t('settings_digest_title') %></h2>
      <p><%= t('settings_digest_desc') %></p>
      <form method="POST" action="/settings/digest">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label class="lang-check-label" style="margin-top:0.8rem">
          <input type="checkbox" name="digest" value="1" <%= emailDigest ? 'checked' : '' %> />
          <%= t('settings_digest_label') %>
        </label>
        <br/>
        <button type="submit" class="btn btn-primary" style="margin-top:0.8rem">
          <%= t('settings_save') %>
        </button>
      </form>
    </section>
  </div>

  <!-- ── Compte & sécurité ───────────────────────────────────────────────── -->
  <div id="compte" class="settings-group">
    <p class="settings-group__title">
      <span class="mdi mdi-shield-account-outline"></span> <%= t('settings_group_account') %>
      <a href="/u/<%= currentUsername %>" class="btn btn-ghost btn-sm" style="margin-left:auto;font-size:0.78rem">
        <span class="mdi mdi-account-circle-outline"></span> <%= t('nav_profile') %>
      </a>
    </p>

    <!-- Avatar -->
    <section class="settings-section">
      <h2><%= t('settings_avatar_title') %></h2>
      <p><%= t('settings_avatar_desc') %></p>

      <div class="avatar-preview-row">
        <% if (avatarUrl) { %>
          <img src="<%= avatarUrl %>?v=<%= Date.now() %>" alt="Avatar" class="avatar-preview" />
        <% } else { %>
          <div class="avatar-placeholder"><span class="mdi mdi-account-circle-outline"></span></div>
        <% } %>

        <div style="display:flex;flex-direction:column;gap:0.5rem">
          <form method="POST" action="/settings/avatar" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label class="btn btn-secondary btn-sm" style="cursor:pointer;margin:0">
              <span class="mdi mdi-upload-outline"></span> <%= t('settings_avatar_upload') %>
              <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif"
                     style="display:none" onchange="this.form.submit()" />
            </label>
          </form>
          <% if (avatarUrl) { %>
          <form method="POST" action="/settings/avatar/delete">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--color-danger)">
              <span class="mdi mdi-delete-outline"></span> <%= t('settings_avatar_delete') %>
            </button>
          </form>
          <% } %>
        </div>
      </div>
      <p class="form-hint"><%= t('settings_avatar_hint') %></p>
    </section>

    <!-- Pseudo -->
    <section class="settings-section">
      <h2><%= t('settings_username_title') %></h2>
      <p><%= t('settings_username_desc') %></p>

      <% if (usernameChangesLeft > 0) { %>
      <form method="POST" action="/settings/username" class="form-card form-card--inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="form-group">
          <label for="new-username"><%= t('settings_username_label') %></label>
          <input type="text" id="new-username" name="username"
                 value="<%= currentUsername %>"
                 minlength="3" maxlength="20"
                 pattern="[a-zA-Z0-9_\-]+"
                 autocomplete="username" required />
          <span class="form-hint"><%- t('settings_username_changes_left', { count: usernameChangesLeft }) %></span>
        </div>
        <button type="submit" class="btn btn-primary"><%= t('settings_username_submit') %></button>
      </form>
      <% } else { %>
        <p class="form-hint" style="margin-top:0.5rem"><%= t('settings_username_limit_reached') %></p>
      <% } %>
    </section>

    <!-- Email -->
    <section class="settings-section">
      <h2><%= t('settings_email_title') %></h2>
      <p><%= t('settings_email_desc') %></p>

      <% if (pendingEmail) { %>
        <div class="alert alert-info" style="margin:0.75rem 0">
          <%- t('settings_email_pending', { email: '<strong>' + pendingEmail + '</strong>' }) %>
        </div>
      <% } %>

      <form method="POST" action="/settings/email" class="form-card form-card--inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="form-group">
          <label for="new-email"><%= t('settings_email_label') %></label>
          <input type="email" id="new-email" name="email"
                 value="<%= currentEmail %>"
                 autocomplete="email" required />
          <span class="form-hint"><%= t('settings_email_hint') %></span>
        </div>
        <button type="submit" class="btn btn-primary"><%= t('settings_email_submit') %></button>
      </form>
    </section>

    <!-- Données personnelles (RGPD) -->
    <section class="settings-section">
      <h2><%= t('settings_data_title') %></h2>
      <p><%= t('settings_data_desc') %></p>

      <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:0.8rem">
        <a href="/account/export" class="btn btn-secondary"><span class="mdi mdi-download-outline"></span> <%= t('settings_export') %></a>

        <details style="width:100%;margin-top:0.5rem">
          <summary class="report-toggle" style="color:#dc2626"><span class="mdi mdi-alert-outline"></span> <%= t('settings_delete_title') %></summary>
          <div style="margin-top:1rem;padding:1.2rem;background:#fef2f2;border-radius:var(--radius-sm);border:1px solid #fecaca">
            <p style="font-size:0.9rem;color:#7f1d1d;margin-bottom:1rem"><%= t('settings_delete_warning') %></p>
            <form method="POST" action="/account/delete" class="form-card form-card--inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="form-group">
                <label for="delete-password"><%= t('settings_password_current') %></label>
                <input type="password" id="delete-password" name="password" required autocomplete="current-password"
                  placeholder="<%= t('settings_delete_confirm_placeholder') %>" />
              </div>
              <button type="submit" class="btn btn-reject"><%= t('settings_delete_submit') %></button>
            </form>
          </div>
        </details>
      </div>
    </section>

    <!-- Mot de passe -->
    <section class="settings-section" id="password-section">
      <h2><%= t('settings_password_title') %></h2>

      <form method="POST" action="/settings/password" class="form-card form-card--inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="form-group">
          <label for="current"><%= t('settings_password_current') %></label>
          <input type="password" id="current" name="current" required autocomplete="current-password" />
        </div>
        <div class="form-group">
          <label for="newpass"><%= t('settings_password_new') %></label>
          <input type="password" id="newpass" name="newpass" required minlength="8" autocomplete="new-password" />
          <span class="form-hint"><%= t('settings_password_hint') %></span>
        </div>
        <div class="form-group">
          <label for="confirm"><%= t('settings_password_confirm') %></label>
          <input type="password" id="confirm" name="confirm" required minlength="8" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-primary"><%= t('settings_password_submit') %></button>
      </form>
    </section>
  </div>

  <!-- ── Succès ──────────────────────────────────────────────────────────── -->
  <div id="succes" class="settings-group">
    <p class="settings-group__title"><span class="mdi mdi-trophy-outline"></span> <%= t('settings_group_achievements') %></p>

    <section class="settings-section">
      <h2><%= t('settings_achievements_title') %></h2>
      <p><%= t('settings_achievements_subtitle') %></p>

      <% const earned = achievements.filter(a => a.earned).length; %>
      <p class="achievements-progress">
        <span class="achievements-count"><%= earned %> / <%= achievements.length %></span>
      </p>

      <div class="achievements-grid">
        <% achievements.forEach(function(ach) { %>
          <div class="achievement-card <%= ach.earned ? 'achievement-card--earned achievement-card--' + ach.rarity : 'achievement-card--locked' %>">
            <div class="achievement-icon"><%= ach.icon %></div>
            <div class="achievement-body">
              <div class="achievement-name"><%= t('achievement_' + ach.id + '_name') %></div>
              <div class="achievement-desc"><%= t('achievement_' + ach.id + '_desc') %></div>
              <% if (ach.earned && ach.earnedAt) { %>
                <div class="achievement-date"><%= t('achievement_earned_on') %> <%= ach.earnedAt.slice(0,10) %></div>
              <% } else if (!ach.earned) { %>
                <div class="achievement-date achievement-locked-label"><%= t('achievement_locked') %></div>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </div>
</div>

<script>
  // Highlight du lien actif dans la nav selon la section visible
  (function() {
    var links = document.querySelectorAll('.settings-nav__link');
    var groups = Array.from(document.querySelectorAll('.settings-group'));
    if (!links.length || !groups.length) return;

    function setActive(id) {
      links.forEach(function(a) {
        a.classList.toggle('active', a.getAttribute('href') === '#' + id);
      });
    }

    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) setActive(e.target.id);
      });
    }, { rootMargin: '-20% 0px -70% 0px' });

    groups.forEach(function(g) { obs.observe(g); });
    setActive(groups[0].id);
  })();
</script>

<%- include('partials/footer') %>
