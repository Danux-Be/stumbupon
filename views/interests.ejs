<%- include('partials/header', { title: t('interests_title') }) %>

<div class="interests-page">
  <div class="interests-header">
    <h1><%= t('interests_title') %></h1>
    <p><%- t('interests_desc') %></p>
  </div>

  <% if (error) { %>
    <p class="form-error interests-error"><%= error %></p>
  <% } %>

  <form method="POST" action="/interests" id="interests-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <p class="interests-count">
      <span id="interests-count"><%= selected.length %></span>&nbsp;<%- t('interests_count', { count: '' }).trim() %>
    </p>

    <div class="categories-grid">
      <% for (const cat of categories) { %>
        <label class="category-card">
          <input
            type="checkbox"
            name="categories"
            value="<%= cat.id %>"
            <%= selected.includes(cat.id) ? 'checked' : '' %>
          />
          <span class="category-emoji"><%= cat.emoji %></span>
          <span class="category-name"><%= cat.localName %></span>
        </label>
      <% } %>
    </div>

    <div class="interests-actions">
      <button type="submit" class="btn btn-primary btn-large" id="interests-submit"
              <%= selected.length < 3 ? 'disabled' : '' %>>
        <%= t('interests_submit') %>
      </button>
    </div>
  </form>

  <script>
    (function () {
      var form    = document.getElementById('interests-form');
      var counter = document.getElementById('interests-count');
      var submit  = document.getElementById('interests-submit');
      if (!form || !counter || !submit) return;

      function recount() {
        var n = form.querySelectorAll('input[type="checkbox"]:checked').length;
        counter.textContent = n;
        submit.disabled = n < 3;
      }

      // approach 1 : change event bubbles depuis la checkbox
      form.addEventListener('change', function (e) {
        if (e.target.type === 'checkbox') recount();
      });

      // approach 2 : click sur le label + délai pour laisser le browser toggler
      form.querySelectorAll('.category-card').forEach(function (label) {
        label.addEventListener('click', function () {
          setTimeout(recount, 0);
        });
      });
    })();
  </script>
</div>

<%- include('partials/footer') %>
