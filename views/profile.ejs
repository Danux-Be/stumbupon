<%- include('partials/header', { title, ogTitle, ogDescription, ogImage, ogUrl }) %>

<div class="profile-page">

<% if (notFound) { %>
  <div class="profile-not-found">
    <p class="profile-not-found__icon">🌀</p>
    <h1><%= t('profile_not_found_title') %></h1>
    <p><%= t('profile_not_found_desc') %></p>
    <a href="/" class="btn btn-primary"><%= t('nav_home') %></a>
  </div>
<% } else { %>

  <!-- ── En-tête ─────────────────────────────────────────────────────── -->
  <div class="profile-header">
    <div class="profile-avatar-wrap">
      <% if (avatarUrl) { %>
        <img src="<%= avatarUrl %>" alt="<%= profile.username %>" class="profile-avatar" />
      <% } else { %>
        <div class="profile-avatar profile-avatar--placeholder">
          <%= profile.username.charAt(0).toUpperCase() %>
        </div>
      <% } %>
    </div>

    <div class="profile-identity">
      <h1 class="profile-username"><%= profile.username %></h1>
      <p class="profile-since">
        <span class="mdi mdi-calendar-outline"></span>
        <%= t('profile_member_since') %> <%= new Date(profile.created_at).toLocaleDateString(currentLang, { year: 'numeric', month: 'long' }) %>
      </p>
      <p class="profile-follow-counts">
        <span><strong><%= followerCount %></strong> <%= t('followers_count_label') %></span>
        <span>·</span>
        <span><strong><%= followingCountVal %></strong> <%= t('following_count_label') %></span>
      </p>
      <div class="profile-own-actions">
        <% if (isOwnProfile) { %>
          <a href="/settings" class="btn btn-ghost btn-sm"><span class="mdi mdi-cog-outline"></span> <%= t('settings_title') %></a>
        <% } else if (locals.user) { %>
          <button class="btn <%= isFollowing ? 'btn-secondary' : 'btn-primary' %> btn-sm" id="follow-btn"
                  data-username="<%= profile.username %>"
                  data-csrf="<%= csrfToken %>"
                  data-following="<%= isFollowing ? '1' : '0' %>">
            <span class="mdi <%= isFollowing ? 'mdi-account-minus-outline' : 'mdi-account-plus-outline' %>"></span>
            <span id="follow-btn-label"><%= isFollowing ? t('unfollow_btn') : t('follow_btn') %></span>
          </button>
        <% } %>
        <button class="btn btn-ghost btn-sm" id="profile-share-btn">
          <span class="mdi mdi-share-variant"></span> <%= t('profile_share') %>
        </button>
      </div>
    </div>
  </div>

  <!-- ── Bio & réseaux sociaux ───────────────────────────────────────── -->
  <% if (profile.bio || profile.social_website || profile.social_twitter || profile.social_github || profile.social_mastodon || profile.social_linkedin || profile.social_instagram || profile.social_reddit) { %>
  <div class="profile-bio-block">
    <% if (profile.bio) { %>
      <p class="profile-bio"><%= profile.bio %></p>
    <% } %>
    <% const socials = [
      profile.social_website   ? { icon: 'mdi-web',       href: profile.social_website,                             label: profile.social_website.replace(/^https?:\/\//, '').split('/')[0] } : null,
      profile.social_twitter   ? { icon: 'mdi-twitter',   href: 'https://x.com/' + profile.social_twitter,          label: '@' + profile.social_twitter } : null,
      profile.social_github    ? { icon: 'mdi-github',    href: 'https://github.com/' + profile.social_github,       label: profile.social_github } : null,
      profile.social_mastodon  ? { icon: 'mdi-mastodon',  href: profile.social_mastodon,                             label: profile.social_mastodon.replace(/^https?:\/\//, '') } : null,
      profile.social_linkedin  ? { icon: 'mdi-linkedin',  href: 'https://linkedin.com/in/' + profile.social_linkedin, label: profile.social_linkedin } : null,
      profile.social_instagram ? { icon: 'mdi-instagram', href: 'https://instagram.com/' + profile.social_instagram,  label: '@' + profile.social_instagram } : null,
      profile.social_reddit    ? { icon: 'mdi-reddit',    href: 'https://reddit.com/u/' + profile.social_reddit,       label: 'u/' + profile.social_reddit } : null,
    ].filter(Boolean); %>
    <% if (socials.length) { %>
    <div class="profile-socials">
      <% socials.forEach(function(s) { %>
        <a href="<%= s.href %>" class="profile-social-link" target="_blank" rel="noopener noreferrer">
          <span class="mdi <%= s.icon %>"></span><span class="profile-social-link__label"><%= s.label %></span>
        </a>
      <% }); %>
    </div>
    <% } %>
  </div>
  <% } %>

  <!-- ── Stats ────────────────────────────────────────────────────────── -->
  <div class="profile-stats">
    <div class="profile-stat">
      <span class="profile-stat__value"><%= stats.discoveries.toLocaleString(currentLang) %></span>
      <span class="profile-stat__label"><span class="mdi mdi-compass-outline"></span> <%= t('profile_stat_discoveries') %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat__value"><%= stats.submissions.toLocaleString(currentLang) %></span>
      <span class="profile-stat__label"><span class="mdi mdi-upload-outline"></span> <%= t('profile_stat_submissions') %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat__value"><%= stats.upvotes.toLocaleString(currentLang) %></span>
      <span class="profile-stat__label"><span class="mdi mdi-thumb-up-outline"></span> <%= t('profile_stat_upvotes') %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat__value"><%= achievements.length %></span>
      <span class="profile-stat__label"><span class="mdi mdi-trophy-outline"></span> <%= t('profile_stat_achievements') %></span>
    </div>
  </div>

  <!-- ── Succès ────────────────────────────────────────────────────────── -->
  <% if (achievements.length) { %>
  <section class="profile-section">
    <h2 class="profile-section__title"><span class="mdi mdi-trophy-outline"></span> <%= t('profile_achievements_title') %></h2>
    <div class="profile-badges">
      <% achievements.forEach(function(ach) { %>
        <div class="profile-badge profile-badge--<%= ach.rarity %>" title="<%= t('achievement_' + ach.id + '_name') %> — <%= t('achievement_' + ach.id + '_desc') %>">
          <span class="profile-badge__icon"><%= ach.icon %></span>
          <span class="profile-badge__name"><%= t('achievement_' + ach.id + '_name') %></span>
        </div>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- ── Soumissions récentes ──────────────────────────────────────────── -->
  <% if (submissions.length) { %>
  <section class="profile-section">
    <h2 class="profile-section__title"><span class="mdi mdi-web"></span> <%= t('profile_submissions_title') %></h2>
    <div class="profile-submissions">
      <% submissions.forEach(function(s) { %>
        <a href="/stumble/<%= s.id %>" class="profile-submission-card">
          <div class="profile-submission-card__cats"><%= s.cats || '' %></div>
          <div class="profile-submission-card__title"><%= s.title %></div>
          <% if (s.description) { %>
            <div class="profile-submission-card__desc"><%= s.description.slice(0, 100) %><%= s.description.length > 100 ? '…' : '' %></div>
          <% } %>
        </a>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- ── Collections publiques ───────────────────────────────────────── -->
  <% if (publicCollections && publicCollections.length) { %>
  <section class="profile-section">
    <h2 class="profile-section__title"><span class="mdi mdi-folder-multiple-outline"></span> <%= t('collections_title') %></h2>
    <div class="profile-collections">
      <% publicCollections.forEach(function(col) { %>
        <a href="/c/<%= profile.username %>/<%= col.slug %>" class="profile-collection-card">
          <span class="mdi mdi-folder-outline profile-collection-card__icon"></span>
          <div>
            <div class="profile-collection-card__title"><%= col.title %></div>
            <div class="profile-collection-card__count"><%= t('collections_sites_count', { count: col.site_count }) %></div>
          </div>
        </a>
      <% }); %>
    </div>
  </section>
  <% } %>

  <!-- ── CTA pour les visiteurs ───────────────────────────────────────── -->
  <% if (!locals.user) { %>
  <div class="profile-cta">
    <p class="profile-cta__text"><%- t('profile_cta', { username: '<strong>' + profile.username + '</strong>' }) %></p>
    <a href="/signup" class="btn btn-primary"><%= t('signup_title') %></a>
    <a href="/stumble" class="btn btn-ghost"><%= t('stumble_btn') %></a>
  </div>
  <% } %>

<% } %>
</div>

<script>
(function() {
  // Follow/unfollow
  var followBtn = document.getElementById('follow-btn');
  if (followBtn) {
    followBtn.addEventListener('click', function() {
      followBtn.disabled = true;
      var username = followBtn.dataset.username;
      var csrf     = followBtn.dataset.csrf;
      fetch('/u/' + username + '/follow', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '_csrf=' + encodeURIComponent(csrf),
      }).then(function(r) { return r.json(); }).then(function(data) {
        followBtn.disabled = false;
        if (!data.ok) return;
        var label = document.getElementById('follow-btn-label');
        var icon  = followBtn.querySelector('.mdi');
        if (data.following) {
          if (label) label.textContent = '<%= t("unfollow_btn") %>';
          if (icon)  icon.className = 'mdi mdi-account-minus-outline';
          followBtn.classList.replace('btn-primary', 'btn-secondary');
        } else {
          if (label) label.textContent = '<%= t("follow_btn") %>';
          if (icon)  icon.className = 'mdi mdi-account-plus-outline';
          followBtn.classList.replace('btn-secondary', 'btn-primary');
        }
        var fc = document.querySelector('.profile-follow-counts strong');
        if (fc) fc.textContent = data.followerCount;
      }).catch(function() { followBtn.disabled = false; });
    });
  }

  var btn = document.getElementById('profile-share-btn');
  if (!btn) return;
  var url  = '<%= ogUrl %>';
  var text = '<%= t("profile_share_text", { username: profile ? profile.username : "" }) %>';
  btn.addEventListener('click', function() {
    if (navigator.share) {
      navigator.share({ title: text, url: url }).catch(function(){});
    } else {
      navigator.clipboard.writeText(url).then(function() {
        var orig = btn.innerHTML;
        btn.innerHTML = '<span class="mdi mdi-check"></span> <%= t("profile_link_copied") %>';
        setTimeout(function() { btn.innerHTML = orig; }, 2500);
      }).catch(function() { window.prompt('', url); });
    }
  });
})();
</script>

<%- include('partials/footer') %>
