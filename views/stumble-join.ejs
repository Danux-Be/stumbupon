<%- include('partials/header', { title: t('guest_join_title') }) %>

<div class="stumble-join">
  <div class="stumble-join__inner">

    <div class="stumble-join__stat">
      <span class="stumble-join__stat-number">5</span>
      <span class="stumble-join__stat-label"><%- t('guest_join_stat') %></span>
    </div>

    <h1 class="stumble-join__title"><%- t('guest_join_title', { limit: guestLimit }) %></h1>
    <p class="stumble-join__desc"><%- t('guest_join_desc') %></p>

    <div class="stumble-join__actions">
      <a href="/signup" class="btn btn-primary btn-xl"><%= t('guest_join_signup') %> →</a>
      <a href="/login"  class="btn btn-secondary">  <%= t('guest_join_login') %></a>
    </div>

    <ul class="stumble-join__perks">
      <li><span class="stumble-join__perk-icon">🎯</span><%- t('guest_join_perk1') %></li>
      <li><span class="stumble-join__perk-icon">👍</span><%- t('guest_join_perk2') %></li>
      <li><span class="stumble-join__perk-icon">🔖</span><%- t('guest_join_perk3') %></li>
      <li><span class="stumble-join__perk-icon">🎛️</span><%- t('guest_join_perk4') %></li>
    </ul>

  </div>
</div>

<%- include('partials/footer') %>
