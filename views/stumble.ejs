<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= site.title %> — StumbleClone</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌀</text></svg>" />
  <meta name="description" content="<%= (site.description || '').slice(0, 160) %>" />
  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="StumbleClone" />
  <meta property="og:title" content="<%= site.title %>" />
  <meta property="og:description" content="<%= (site.description || '').slice(0, 200) %>" />
  <meta property="og:url" content="<%= baseUrl %>/stumble/<%= site.id %>" />
  <meta property="og:image" content="<%= baseUrl %>/icons/icon-512.svg" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= site.title %>" />
  <meta name="twitter:description" content="<%= (site.description || '').slice(0, 200) %>" />
  <link rel="canonical" href="<%= baseUrl %>/stumble/<%= site.id %>" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= cssVersion %>" />
  <meta name="csrf" content="<%= csrfToken %>" />
  <script>
    (function(){
      var t=localStorage.getItem('sc-theme');
      if(t==='dark') document.documentElement.classList.add('dark');
      else if(t==='light') document.documentElement.classList.add('light');
      if(localStorage.getItem('sc-animations')==='1') document.documentElement.classList.add('sc-anim');
      if(localStorage.getItem('sc-bar-pos')==='bottom') document.documentElement.classList.add('bar-bottom');
    })();
  </script>
</head>
<body class="stumble-iframe-page">

  <%
    var hostname = site.url;
    try { hostname = new URL(site.url).hostname; } catch(e) {}
  %>

  <!-- ── Barre d'outils ────────────────────────────────────────────────── -->
  <div class="stumble-bar">

    <!-- Gauche : logo + infos site -->
    <div class="stumble-bar__left">
      <a href="/" class="stumble-bar__logo" title="StumbleClone">🌀</a>
      <img src="https://<%= hostname %>/favicon.ico"
           class="stumble-bar__favicon" width="20" height="20" alt=""
           onerror="this.onerror=null;this.style.display='none'" />
      <div class="stumble-bar__site">
        <% if (isVideo) { %><span class="stumble-bar__badge mdi mdi-video-outline"></span><% } %>
        <span class="stumble-bar__title"><%= site.title %></span>
        <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer"
           class="stumble-bar__url"><span class="mdi mdi-open-in-new"></span> <%= hostname %></a>
      </div>
    </div>

    <!-- Centre : votes + suivant -->
    <div class="stumble-bar__center">
      <% if (!isGuest) { %>
      <div class="vote-bar">
        <button class="vote-btn <%= userVote === 1  ? 'vote-btn--active' : '' %>"
                id="vote-up" title="Like (L)"><span class="mdi mdi-thumb-up"></span></button>
        <span class="vote-score <%= score > 0 ? 'vote-score--pos' : score < 0 ? 'vote-score--neg' : '' %>"
              id="vote-score"><%= score > 0 ? '+' : '' %><%= score %></span>
        <button class="vote-btn <%= userVote === -1 ? 'vote-btn--active' : '' %>"
                id="vote-down" title="Dislike (D)"><span class="mdi mdi-thumb-down"></span></button>
      </div>
      <% } %>

      <% if (!isGuest && siteConfig && siteConfig.less_of_this === '1') { %>
      <button class="btn btn-ghost btn-sm" id="less-btn">
        <span class="mdi mdi-chevron-double-down"></span> <span class="stumble-bar__label"><%= t('stumble_less_of_this') %></span>
      </button>
      <% } %>

      <a href="/stumble" class="btn btn-primary btn-sm" id="bar-next-btn" title="Site suivant (Espace / →)"><%= t('stumble_next') %> <span class="mdi mdi-arrow-right"></span></a>
    </div>

    <!-- Droite : actions secondaires -->
    <div class="stumble-bar__right">
      <button class="btn btn-ghost btn-sm" id="info-toggle" title="Infos"><span class="mdi mdi-information-outline"></span></button>

      <button class="btn btn-ghost btn-sm comments-toggle" id="comments-toggle" title="<%= t('comments_title') %>">
        <span class="mdi mdi-comment-outline"></span><% if (comments.length) { %><span class="comments-badge" id="comments-count"><%= comments.length %></span><% } else { %><span class="comments-badge" id="comments-count" style="display:none">0</span><% } %>
      </button>

      <% if (!isGuest && user && user.isAdmin) { %>
      <button class="btn btn-reject btn-sm" id="admin-reject-btn"
              title="<%= t('stumble_admin_reject') %>"><span class="mdi mdi-delete-outline"></span></button>
      <% } %>
      <button class="btn btn-ghost btn-sm stumble-bar__hamburger" id="mobile-menu-btn" title="Menu">
        <span class="mdi mdi-menu"></span>
      </button>
    </div>

  </div>

  <!-- ── Volet d'informations ─────────────────────────────────────────────── -->
  <div class="info-panel" id="info-panel" style="display:none">
    <div class="comments-drawer__header">
      <span class="comments-drawer__title">ℹ️ <%= site.title %></span>
      <button class="btn btn-ghost btn-sm" id="info-close"><span class="mdi mdi-close"></span></button>
    </div>
    <div class="info-panel__body">

      <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer" class="info-panel__url">
        <span class="mdi mdi-open-in-new"></span> <%= hostname %>
      </a>

      <% if (site.description) { %>
        <p class="info-panel__desc"><%= site.description %></p>
      <% } %>

      <% if (categories && categories.length) { %>
      <div class="info-panel__section">
        <span class="info-panel__label"><%= t('stumble_why_categories') %></span>
        <div class="info-panel__tags">
          <% categories.forEach(function(cat) { %>
            <span class="stumble-tag stumble-tag--sm"><%= cat.emoji %> <%= cat.localName %></span>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (submittedBy) { %>
      <div class="info-panel__section">
        <span class="info-panel__label">👤 <%= t('stumble_submitted_by') %></span>
        <span class="info-panel__value"><%= submittedBy %></span>
      </div>
      <% } %>

      <div class="info-panel__section">
        <button class="btn btn-secondary btn-sm" id="info-share-btn" style="width:100%">
          <span class="mdi mdi-share-variant"></span> <%= t('stumble_share') %>
        </button>
      </div>

      <% if (canEmbed && !isVideo) { %>
      <div class="info-panel__section">
        <button class="btn btn-ghost btn-sm" id="info-cant-embed-btn"
                style="width:100%;color:var(--color-text-muted)">
          <span class="mdi mdi-web-off"></span> Ce site ne s'affiche pas ?
        </button>
      </div>
      <% } %>

      <% if (!isGuest) { %>
      <div class="info-panel__section info-panel__report">
        <span class="info-panel__label"><span class="mdi mdi-flag-outline"></span> <%= t('report_link') %></span>
        <form method="POST" action="/report/<%= site.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <textarea name="reason" rows="2" maxlength="500" class="comments-input"
            placeholder="<%= t('report_reason_placeholder') %>"></textarea>
          <button type="submit" class="btn btn-secondary btn-sm" style="margin-top:0.4rem;width:100%">
            <%= t('report_submit') %>
          </button>
        </form>
      </div>
      <% } %>

    </div>
  </div>

  <!-- ── Tiroir de commentaires (desktop uniquement) ────────────────────── -->
  <div class="comments-drawer" id="comments-drawer" style="display:none">
    <div class="comments-drawer__header">
      <span class="comments-drawer__title">💬 <%= t('comments_title') %></span>
      <button class="btn btn-ghost btn-sm" id="comments-close"><span class="mdi mdi-close"></span></button>
    </div>
    <div class="comments-drawer__list" id="comments-list">
      <% if (!comments.length) { %>
        <p class="comments-empty" id="comments-empty"><%= t('comments_empty') %></p>
      <% } else { %>
        <% comments.forEach(function(comment) { %>
        <div class="comment-item" data-id="<%= comment.id %>">
          <div class="comment-meta">
            <span class="comment-username"><%= comment.username %></span>
            <span class="comment-date"><%= comment.created_at.slice(0, 16) %></span>
            <% if (!isGuest && (currentUserId === comment.user_id || (user && user.isAdmin))) { %>
            <button class="comment-delete btn btn-ghost btn-sm" data-id="<%= comment.id %>"><span class="mdi mdi-close"></span></button>
            <% } %>
          </div>
          <p class="comment-body"><%= comment.body %></p>
        </div>
        <% }) %>
      <% } %>
    </div>
    <div class="comments-drawer__form">
      <% if (!isGuest) { %>
        <textarea id="comment-input" class="comments-input" placeholder="<%= t('comments_placeholder') %>" maxlength="500" rows="3"></textarea>
        <button type="button" id="comment-submit" class="btn btn-primary btn-sm"><%= t('comments_submit') %></button>
      <% } else { %>
        <p class="comments-login-prompt"><a href="/login"><%= t('comments_login') %></a></p>
      <% } %>
    </div>
  </div>


  <!-- ── Volet mobile (hamburger) ──────────────────────────────────────────── -->
  <div class="mobile-drawer" id="mobile-drawer" style="display:none">
    <div class="mobile-drawer__header">
      <div class="mobile-drawer__header-site">
        <img src="https://<%= hostname %>/favicon.ico"
             class="mobile-drawer__favicon" width="20" height="20" alt=""
             onerror="this.onerror=null;this.style.display='none'" />
        <div style="min-width:0">
          <div class="stumble-bar__title"><% if (isVideo) { %><span class="stumble-bar__badge mdi mdi-video-outline" style="margin-right:0.3rem"></span><% } %><%= site.title %></div>
          <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer" class="stumble-bar__url">
            <span class="mdi mdi-open-in-new"></span> <%= hostname %>
          </a>
        </div>
      </div>
      <button class="btn btn-ghost btn-sm" id="mobile-drawer-close">
        <span class="mdi mdi-close"></span>
      </button>
    </div>

    <div class="mobile-drawer__body">

      <!-- Infos site -->
      <% if (site.description || (categories && categories.length) || submittedBy) { %>
      <div class="mobile-drawer__section">
        <% if (site.description) { %><p class="info-panel__desc" style="margin:0"><%= site.description %></p><% } %>
        <% if (categories && categories.length) { %>
        <div>
          <div class="info-panel__label" style="margin-bottom:0.35rem"><%= t('stumble_why_categories') %></div>
          <div class="info-panel__tags">
            <% categories.forEach(function(cat) { %>
              <span class="stumble-tag stumble-tag--sm"><%= cat.emoji %> <%= cat.localName %></span>
            <% }) %>
          </div>
        </div>
        <% } %>
        <% if (submittedBy) { %>
          <div class="info-panel__label" style="margin:0">👤 <%= t('stumble_submitted_by') %> : <span style="font-weight:400;text-transform:none;letter-spacing:0"><%= submittedBy %></span></div>
        <% } %>
      </div>
      <% } %>

      <!-- Actions -->
      <div class="mobile-drawer__section">
        <button class="btn btn-secondary btn-sm" id="mobile-share-btn" style="width:100%">
          <span class="mdi mdi-share-variant"></span> <%= t('stumble_share') %>
        </button>
        <% if (canEmbed && !isVideo) { %>
        <button class="btn btn-ghost btn-sm" id="mobile-cant-embed-btn"
                style="width:100%;color:var(--color-text-muted)">
          <span class="mdi mdi-web-off"></span> Ce site ne s'affiche pas ?
        </button>
        <% } %>
        <% if (!isGuest && siteConfig && siteConfig.less_of_this === '1') { %>
        <button class="btn btn-ghost btn-sm" id="mobile-less-btn" style="width:100%">
          <span class="mdi mdi-chevron-double-down"></span> <%= t('stumble_less_of_this') %>
        </button>
        <% } %>
      </div>

      <!-- Signaler -->
      <% if (!isGuest) { %>
      <div class="mobile-drawer__section">
        <div class="mobile-drawer__section-title">
          <span class="mdi mdi-flag-outline"></span> <%= t('report_link') %>
        </div>
        <form method="POST" action="/report/<%= site.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <textarea name="reason" rows="2" maxlength="500" class="comments-input"
            placeholder="<%= t('report_reason_placeholder') %>"></textarea>
          <button type="submit" class="btn btn-secondary btn-sm" style="margin-top:0.4rem;width:100%">
            <%= t('report_submit') %>
          </button>
        </form>
      </div>
      <% } %>

      <!-- Admin -->
      <% if (!isGuest && user && user.isAdmin) { %>
      <div class="mobile-drawer__section">
        <button class="btn btn-reject btn-sm" id="mobile-admin-reject-btn" style="width:100%">
          <span class="mdi mdi-delete-outline"></span> <%= t('stumble_admin_reject') %>
        </button>
      </div>
      <% } %>

      <!-- Paramètres & nav -->
      <div class="mobile-drawer__section">
        <% if (isGuest) { %>
        <a href="/signup" class="btn btn-primary btn-sm" style="width:100%">
          <span class="mdi mdi-account-plus-outline"></span> <%= t('guest_banner_cta') %>
        </a>
        <a href="/login" class="btn btn-ghost btn-sm" style="width:100%;justify-content:flex-start">
          <span class="mdi mdi-login"></span> <%= t('nav_login') %>
        </a>
        <% } else { %>
        <a href="/favorites" class="btn btn-ghost btn-sm" style="width:100%;justify-content:flex-start">
          <span class="mdi mdi-bookmark-outline"></span> Favoris
        </a>
        <% } %>
        <a href="/settings" class="btn btn-ghost btn-sm" style="width:100%;justify-content:flex-start">
          <span class="mdi mdi-cog-outline"></span> Paramètres
        </a>
      </div>

    </div>
  </div>
  <div class="mobile-drawer-overlay" id="mobile-drawer-overlay" style="display:none"></div>
  <a href="/stumble" class="stumble-mobile-next"><%= t('stumble_next') %> <span class="mdi mdi-arrow-right"></span></a>
  <button class="stumble-mobile-fab" id="mobile-comments-fab">
    <span class="mdi mdi-comment-outline"></span>
    <span class="comments-badge" id="mobile-fab-badge"
          style="<%= comments.length ? '' : 'display:none' %>"><%= comments.length || '' %></span>
  </button>

  <% if (flashLessOfThis) { %>
    <div class="stumble-flash" id="stumble-flash"><%= t('stumble_less_done') %></div>
  <% } %>

  <!-- ── Iframe ────────────────────────────────────────────────────────── -->
  <% if (isVideo && embedUrl) { %>
  <iframe
    src="<%= embedUrl %>"
    class="stumble-iframe stumble-iframe--video"
    id="stumble-iframe"
    title="<%= site.title %>"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
  <% } else if (canEmbed) { %>
  <iframe
    src="<%= site.url %>"
    class="stumble-iframe"
    id="stumble-iframe"
    title="<%= site.title %>"
    sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
  ></iframe>
  <% } %>

  <!-- ── Carte fallback ───────────────────────────────────────────────── -->
  <div class="stumble-card-wrap" id="stumble-card-wrap"
       style="<%= canEmbed ? 'display:none' : 'display:flex' %>">
    <div class="stumble-card">
      <div class="stumble-meta">
        <% categories.forEach(cat => { %>
          <span class="stumble-tag"><%= cat.emoji %> <%= cat.localName %></span>
        <% }) %>
      </div>
      <h1 class="stumble-title"><%= site.title %></h1>
      <p class="stumble-desc"><%= site.description %></p>
      <p class="stumble-url"><%= hostname %></p>
      <div class="stumble-actions">
        <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer"
           class="btn btn-primary btn-large">
          <%= t('stumble_open_tab') %> <span class="mdi mdi-open-in-new"></span>
        </a>
        <a href="/stumble" class="btn btn-secondary btn-large">
          <%= t('stumble_next') %> →
        </a>
      </div>

      <details class="why-details" style="margin-top:1.5rem">
        <summary class="why-toggle"><%= t('stumble_why_title') %></summary>
        <div class="why-body">
          <div class="why-row">
            <span class="why-label"><%= t('stumble_why_categories') %></span>
            <span class="why-cats">
              <% const matchingCats = categories.filter(c => c.in_interests); %>
              <% (matchingCats.length ? matchingCats : categories).forEach(cat => { %>
                <span class="stumble-tag stumble-tag--why">
                  <%= cat.emoji %> <%= cat.localName %>
                  <% if (matchingCats.length) { %>
                    <span class="why-weight">×<%= parseFloat(cat.weight).toFixed(1) %></span>
                  <% } %>
                </span>
              <% }) %>
            </span>
          </div>
        </div>
      </details>
    </div>
  </div>

  <script>
    var CSRF     = document.querySelector('meta[name="csrf"]').getAttribute('content');
    var SITE_ID  = '<%= site.id %>';
    var IS_GUEST = <%= isGuest ? 'true' : 'false' %>;
    var userVote = <%= userVote === null || userVote === undefined ? 'null' : userVote %>;
    var score    = <%= score %>;
    var ANIMATIONS = document.documentElement.classList.contains('sc-anim');

    // Navigation vers le site suivant (avec animation si activée)
    function navigateNext() {
      if (!ANIMATIONS) { window.location.href = '/stumble'; return; }
      var bar      = document.querySelector('.stumble-bar');
      var card     = document.querySelector('.stumble-card');
      var iframeEl = document.getElementById('stumble-iframe');
      var cWrap    = document.getElementById('stumble-card-wrap');
      var isCard   = !cWrap || cWrap.style.display !== 'none';
      var target   = isCard ? card : iframeEl;
      if (bar)    bar.style.animation    = 'sc-bar-out 200ms ease-in both';
      if (target) {
        target.style.transformOrigin = 'right center';
        target.style.animation = 'sc-flip-out 260ms cubic-bezier(0.4,0,0.2,1) both';
      }
      setTimeout(function() { window.location.href = '/stumble'; }, 280);
    }

    // ── Votes (fetch, pas de rechargement d'iframe) ────────────────────────
    function postVote(dir) {
      fetch('/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '_csrf=' + encodeURIComponent(CSRF) +
              '&site_id=' + SITE_ID + '&direction=' + dir,
      });
      if (userVote === dir) { score -= dir;  userVote = null; }
      else                  { if (userVote !== null) score -= userVote; score += dir; userVote = dir; }
      var up = document.getElementById('vote-up');
      var dn = document.getElementById('vote-down');
      var sc = document.getElementById('vote-score');
      up.classList.toggle('vote-btn--active', userVote === 1);
      dn.classList.toggle('vote-btn--active', userVote === -1);
      sc.textContent = (score > 0 ? '+' : '') + score;
      sc.className = 'vote-score' + (score > 0 ? ' vote-score--pos' : score < 0 ? ' vote-score--neg' : '');
    }
    var voteUp = document.getElementById('vote-up');
    var voteDn = document.getElementById('vote-down');
    if (voteUp) voteUp.addEventListener('click', function() { postVote(1);  });
    if (voteDn) voteDn.addEventListener('click', function() { postVote(-1); });

    // ── Moins de ça ────────────────────────────────────────────────────────
    var lessBtnEl = document.getElementById('less-btn');
    if (lessBtnEl) {
      lessBtnEl.addEventListener('click', function() {
        fetch('/less-of-this', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF) + '&site_id=' + SITE_ID,
        }).then(function() { navigateNext(); });
      });
    }

    // ── Rejet admin rapide ─────────────────────────────────────────────────
    var adminRejectBtn = document.getElementById('admin-reject-btn');
    if (adminRejectBtn) {
      adminRejectBtn.addEventListener('click', function() {
        if (!confirm('<%= t('stumble_admin_reject_confirm') %>')) return;
        fetch('/admin/site/' + SITE_ID + '/reject', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF),
        }).then(function() { navigateNext(); });
      });
    }

    // ── Interception des liens "Site suivant" ──────────────────────────────
    document.querySelectorAll('a[href="/stumble"]').forEach(function(a) {
      a.addEventListener('click', function(e) { e.preventDefault(); navigateNext(); });
    });

    // ── Détection du blocage iframe (X-Frame-Options → about:blank) ───────
    var iframe   = document.getElementById('stumble-iframe');
    var cardWrap = document.getElementById('stumble-card-wrap');

    function showCard() {
      if (iframe)    iframe.style.display   = 'none';
      if (cardWrap)  cardWrap.style.display = 'flex';
      var cantEmbedBtn = document.getElementById('info-cant-embed-btn');
      if (cantEmbedBtn) cantEmbedBtn.style.display = 'none';
      var mobileCantEmbed = document.getElementById('mobile-cant-embed-btn');
      if (mobileCantEmbed) mobileCantEmbed.style.display = 'none';
    }

    if (iframe) {
      iframe.addEventListener('load', function() {
        try {
          var loc = iframe.contentWindow.location.href;
          if (loc === 'about:blank') showCard();
        } catch (e) {
          // SecurityError → cross-origin → chargement réussi
        }
      });
    }

    var cantEmbedBtn = document.getElementById('info-cant-embed-btn');
    if (cantEmbedBtn) cantEmbedBtn.addEventListener('click', showCard);

    // ── Partager (depuis le volet ℹ️) ─────────────────────────────────────
    var SHARE_URL   = window.location.origin + '/stumble/<%= site.id %>';
    var SHARE_TITLE = '<%= site.title.replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>';

    function doShare(btn) {
      if (navigator.share) {
        navigator.share({ title: SHARE_TITLE, url: SHARE_URL }).catch(function() {});
        return;
      }
      navigator.clipboard.writeText(SHARE_URL).then(function() {
        var orig = btn.textContent;
        btn.textContent = '✅ Copié !';
        setTimeout(function() { btn.textContent = orig; }, 2000);
      }).catch(function() { window.prompt('Copie ce lien :', SHARE_URL); });
    }

    // ── Volet ℹ️ ──────────────────────────────────────────────────────────
    var infoPanel   = document.getElementById('info-panel');
    var infoToggle  = document.getElementById('info-toggle');
    var infoClose   = document.getElementById('info-close');
    var infoShareBtn = document.getElementById('info-share-btn');

    function openInfoPanel() {
      closeDrawer(); // ferme les commentaires si ouverts
      infoPanel.style.display = 'flex';
      infoPanel.offsetHeight;
      infoPanel.classList.add('comments-drawer--open');
    }
    function closeInfoPanel() {
      infoPanel.classList.remove('comments-drawer--open');
    }
    infoPanel.addEventListener('transitionend', function() {
      if (!infoPanel.classList.contains('comments-drawer--open')) {
        infoPanel.style.display = 'none';
      }
    });
    if (infoToggle) {
      infoToggle.addEventListener('click', function() {
        if (infoPanel.style.display === 'none' || !infoPanel.classList.contains('comments-drawer--open')) {
          openInfoPanel();
        } else {
          closeInfoPanel();
        }
      });
    }
    if (infoClose)    infoClose.addEventListener('click', closeInfoPanel);
    if (infoShareBtn) infoShareBtn.addEventListener('click', function() { doShare(infoShareBtn); });

    // ── Raccourcis clavier ─────────────────────────────────────────────────
    document.addEventListener('keydown', function(e) {
      var tag = document.activeElement ? document.activeElement.tagName : '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (e.ctrlKey || e.altKey || e.metaKey) return;
      switch (e.key) {
        case ' ':
        case 'ArrowRight':
          e.preventDefault();
          navigateNext();
          break;
        case 'l': case 'L':
          if (!IS_GUEST) { e.preventDefault(); postVote(1); }
          break;
        case 'd': case 'D':
          if (!IS_GUEST) { e.preventDefault(); postVote(-1); }
          break;
        case 'o': case 'O':
          e.preventDefault();
          window.open('<%= site.url %>', '_blank', 'noopener,noreferrer');
          break;
      }
    });

    // ── Commentaires ───────────────────────────────────────────────────────
    var commentsDrawer  = document.getElementById('comments-drawer');
    var commentsToggle  = document.getElementById('comments-toggle');
    var commentsClose   = document.getElementById('comments-close');
    var commentsList    = document.getElementById('comments-list');
    var commentsCount        = document.getElementById('comments-count');
    var mobileCommentsCount  = document.getElementById('mobile-fab-badge');
    var commentInput         = document.getElementById('comment-input');
    var commentSubmit        = document.getElementById('comment-submit');
    var IS_ADMIN             = <%= (user && user.isAdmin) ? 'true' : 'false' %>;
    var CURRENT_USER_ID      = <%= currentUserId || 'null' %>;
    var EMPTY_MSG            = '<%= t('comments_empty') %>';

    function escHtml(s) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function updateCount(n) {
      if (commentsCount) { commentsCount.textContent = n || ''; commentsCount.style.display = n > 0 ? '' : 'none'; }
      if (mobileCommentsCount) { mobileCommentsCount.textContent = n || ''; mobileCommentsCount.style.display = n > 0 ? '' : 'none'; }
    }

    function openDrawer() {
      closeInfoPanel(); // ferme le volet ℹ️ si ouvert
      commentsDrawer.style.display = 'flex';
      commentsDrawer.offsetHeight;
      commentsDrawer.classList.add('comments-drawer--open');
    }
    function closeDrawer() {
      commentsDrawer.classList.remove('comments-drawer--open');
    }
    commentsDrawer.addEventListener('transitionend', function() {
      if (!commentsDrawer.classList.contains('comments-drawer--open')) {
        commentsDrawer.style.display = 'none';
      }
    });

    if (commentsToggle) {
      commentsToggle.addEventListener('click', function() {
        if (commentsDrawer.style.display === 'none' || !commentsDrawer.classList.contains('comments-drawer--open')) {
          openDrawer();
        } else {
          closeDrawer();
        }
      });
    }
    if (commentsClose) {
      commentsClose.addEventListener('click', closeDrawer);
    }

    if (commentSubmit) {
      commentSubmit.addEventListener('click', function() {
        var body = commentInput ? commentInput.value.trim() : '';
        if (!body) return;
        commentSubmit.disabled = true;
        fetch('/stumble/' + SITE_ID + '/comment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF) + '&body=' + encodeURIComponent(body),
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          commentSubmit.disabled = false;
          if (!data.comment) return;
          commentInput.value = '';
          var emptyEl = document.getElementById('comments-empty');
          if (emptyEl) emptyEl.remove();
          var delBtn = '<button class="comment-delete btn btn-ghost btn-sm" data-id="' + data.comment.id + '"><span class="mdi mdi-close"></span></button>';
          var div = document.createElement('div');
          div.className = 'comment-item';
          div.dataset.id = data.comment.id;
          div.innerHTML =
            '<div class="comment-meta">' +
              '<span class="comment-username">' + escHtml(data.comment.username) + '</span>' +
              '<span class="comment-date">' + escHtml(data.comment.created_at) + '</span>' +
              delBtn +
            '</div>' +
            '<p class="comment-body">' + escHtml(data.comment.body) + '</p>';
          commentsList.appendChild(div);
          commentsList.scrollTop = commentsList.scrollHeight;
          var n = parseInt(commentsCount.textContent || '0') + 1;
          updateCount(n);
        })
        .catch(function() { commentSubmit.disabled = false; });
      });
    }

    if (commentsList) {
      commentsList.addEventListener('click', function(e) {
        var btn = e.target.closest('.comment-delete');
        if (!btn) return;
        var id = btn.dataset.id;
        fetch('/comment/' + id + '/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF),
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) return;
          var item = btn.closest('.comment-item');
          if (item) item.remove();
          var n = Math.max(0, parseInt(commentsCount.textContent || '1') - 1);
          updateCount(n);
          if (!commentsList.querySelector('.comment-item')) {
            var p = document.createElement('p');
            p.className = 'comments-empty';
            p.id = 'comments-empty';
            p.textContent = EMPTY_MSG;
            commentsList.appendChild(p);
          }
        });
      });
    }

    // ── Volet mobile ──────────────────────────────────────────────────────
    var mobileDrawer      = document.getElementById('mobile-drawer');
    var mobileMenuBtn     = document.getElementById('mobile-menu-btn');
    var mobileDrawerClose = document.getElementById('mobile-drawer-close');
    var mobileOverlay     = document.getElementById('mobile-drawer-overlay');

    function openMobileDrawer() {
      if (!mobileDrawer) return;
      mobileDrawer.style.display = 'flex';
      mobileDrawer.offsetHeight;
      mobileDrawer.classList.add('mobile-drawer--open');
      if (mobileOverlay) {
        mobileOverlay.style.display = 'block';
        mobileOverlay.offsetHeight;
        mobileOverlay.classList.add('mobile-drawer-overlay--visible');
      }
      document.body.style.overflow = 'hidden';
    }
    function closeMobileDrawer() {
      if (!mobileDrawer) return;
      mobileDrawer.classList.remove('mobile-drawer--open');
      if (mobileOverlay) mobileOverlay.classList.remove('mobile-drawer-overlay--visible');
      document.body.style.overflow = '';
    }
    if (mobileDrawer) {
      mobileDrawer.addEventListener('transitionend', function() {
        if (!mobileDrawer.classList.contains('mobile-drawer--open')) {
          mobileDrawer.style.display = 'none';
          if (mobileOverlay) mobileOverlay.style.display = 'none';
        }
      });
    }
    if (mobileMenuBtn)     mobileMenuBtn.addEventListener('click', openMobileDrawer);
    if (mobileDrawerClose) mobileDrawerClose.addEventListener('click', closeMobileDrawer);
    if (mobileOverlay)     mobileOverlay.addEventListener('click', closeMobileDrawer);

    var mobileCommentsFab = document.getElementById('mobile-comments-fab');
    if (mobileCommentsFab) {
      mobileCommentsFab.addEventListener('click', function() {
        if (commentsDrawer.style.display === 'none' || !commentsDrawer.classList.contains('comments-drawer--open')) {
          openDrawer();
        } else {
          closeDrawer();
        }
      });
    }

    var mobileShareBtn = document.getElementById('mobile-share-btn');
    if (mobileShareBtn) mobileShareBtn.addEventListener('click', function() { doShare(mobileShareBtn); });

    var mobileCantEmbedBtn = document.getElementById('mobile-cant-embed-btn');
    if (mobileCantEmbedBtn) mobileCantEmbedBtn.addEventListener('click', function() { showCard(); closeMobileDrawer(); });

    var mobileLessBtn = document.getElementById('mobile-less-btn');
    if (mobileLessBtn) {
      mobileLessBtn.addEventListener('click', function() {
        fetch('/less-of-this', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF) + '&site_id=' + SITE_ID,
        }).then(function() { navigateNext(); });
      });
    }

    var mobileAdminRejectBtn = document.getElementById('mobile-admin-reject-btn');
    if (mobileAdminRejectBtn) {
      mobileAdminRejectBtn.addEventListener('click', function() {
        if (!confirm('<%= t('stumble_admin_reject_confirm') %>')) return;
        fetch('/admin/site/' + SITE_ID + '/reject', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF),
        }).then(function() { navigateNext(); });
      });
    }

    var mobileCommentsList  = document.getElementById('mobile-comments-list');
    var mobileCommentInput  = document.getElementById('mobile-comment-input');
    var mobileCommentSubmit = document.getElementById('mobile-comment-submit');

    if (mobileCommentSubmit) {
      mobileCommentSubmit.addEventListener('click', function() {
        var body = mobileCommentInput ? mobileCommentInput.value.trim() : '';
        if (!body) return;
        mobileCommentSubmit.disabled = true;
        fetch('/stumble/' + SITE_ID + '/comment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF) + '&body=' + encodeURIComponent(body),
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          mobileCommentSubmit.disabled = false;
          if (!data.comment) return;
          mobileCommentInput.value = '';
          var emptyEl = document.getElementById('mobile-comments-empty');
          if (emptyEl) emptyEl.remove();
          var div = document.createElement('div');
          div.className = 'comment-item';
          div.dataset.id = data.comment.id;
          div.innerHTML =
            '<div class="comment-meta">' +
              '<span class="comment-username">' + escHtml(data.comment.username) + '</span>' +
              '<span class="comment-date">' + escHtml(data.comment.created_at) + '</span>' +
              '<button class="comment-delete btn btn-ghost btn-sm" data-id="' + data.comment.id + '"><span class="mdi mdi-close"></span></button>' +
            '</div>' +
            '<p class="comment-body">' + escHtml(data.comment.body) + '</p>';
          mobileCommentsList.appendChild(div);
          mobileCommentsList.scrollTop = mobileCommentsList.scrollHeight;
          var n = parseInt((commentsCount && commentsCount.textContent) || '0') + 1;
          updateCount(n);
        })
        .catch(function() { mobileCommentSubmit.disabled = false; });
      });
    }

    if (mobileCommentsList) {
      mobileCommentsList.addEventListener('click', function(e) {
        var btn = e.target.closest('.comment-delete');
        if (!btn) return;
        var id = btn.dataset.id;
        fetch('/comment/' + id + '/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF),
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) return;
          var item = btn.closest('.comment-item');
          if (item) item.remove();
          var n = Math.max(0, parseInt((commentsCount && commentsCount.textContent) || '1') - 1);
          updateCount(n);
          if (!mobileCommentsList.querySelector('.comment-item')) {
            var p = document.createElement('p');
            p.className = 'comments-empty';
            p.id = 'mobile-comments-empty';
            p.textContent = EMPTY_MSG;
            mobileCommentsList.appendChild(p);
          }
        });
      });
    }

    // ── Flash auto-dismiss ─────────────────────────────────────────────────
    var flash = document.getElementById('stumble-flash');
    if (flash) setTimeout(function() {
      flash.style.transition = 'opacity 0.5s';
      flash.style.opacity    = '0';
      setTimeout(function() { flash.remove(); }, 500);
    }, 3000);
  </script>
</body>
</html>
