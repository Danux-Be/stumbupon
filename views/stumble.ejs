<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= site.title %> — StumbleClone</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌀</text></svg>" />
  <meta name="description" content="<%= (site.description || '').slice(0, 160) %>" />
  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="StumbleClone" />
  <meta property="og:title" content="<%= site.title %>" />
  <meta property="og:description" content="<%= (site.description || '').slice(0, 200) %>" />
  <meta property="og:url" content="<%= baseUrl %>/stumble/<%= site.id %>" />
  <meta property="og:image" content="<%= baseUrl %>/icons/icon-512.svg" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= site.title %>" />
  <meta name="twitter:description" content="<%= (site.description || '').slice(0, 200) %>" />
  <link rel="canonical" href="<%= baseUrl %>/stumble/<%= site.id %>" />
  <link rel="stylesheet" href="/style.css" />
  <meta name="csrf" content="<%= csrfToken %>" />
  <script>
    (function(){
      if(localStorage.getItem('sc-animations')==='1') document.documentElement.classList.add('sc-anim');
      if(localStorage.getItem('sc-bar-pos')==='bottom') document.documentElement.classList.add('bar-bottom');
    })();
  </script>
</head>
<body class="stumble-iframe-page">

  <%
    var hostname = site.url;
    try { hostname = new URL(site.url).hostname; } catch(e) {}
  %>

  <!-- ── Barre d'outils ────────────────────────────────────────────────── -->
  <div class="stumble-bar">
    <a href="/" class="stumble-bar__logo" title="StumbleClone">🌀</a>

    <div class="stumble-bar__site">
      <span class="stumble-bar__title"><%= site.title %></span>
      <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer"
         class="stumble-bar__url">↗ <%= hostname %></a>
    </div>

    <div class="stumble-bar__actions">
      <% if (!isGuest) { %>
      <div class="vote-bar">
        <button class="vote-btn <%= userVote === 1  ? 'vote-btn--active' : '' %>"
                id="vote-up" title="Like (L)">👍</button>
        <span class="vote-score <%= score > 0 ? 'vote-score--pos' : score < 0 ? 'vote-score--neg' : '' %>"
              id="vote-score"><%= score > 0 ? '+' : '' %><%= score %></span>
        <button class="vote-btn <%= userVote === -1 ? 'vote-btn--active' : '' %>"
                id="vote-down" title="Dislike (D)">👎</button>
      </div>

      <button class="btn btn-ghost btn-sm" id="less-btn">
        🔽 <span class="stumble-bar__label"><%= t('stumble_less_of_this') %></span>
      </button>

      <details class="stumble-bar__report-wrap">
        <summary class="btn btn-ghost btn-sm" title="<%= t('report_link') %>">⚑</summary>
        <div class="stumble-bar__report-popup">
          <form method="POST" action="/report/<%= site.id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <textarea name="reason" rows="2" maxlength="500"
              placeholder="<%= t('report_reason_placeholder') %>"></textarea>
            <button type="submit" class="btn btn-secondary btn-sm"><%= t('report_submit') %></button>
          </form>
        </div>
      </details>
      <% } %>

      <button class="btn btn-ghost btn-sm" id="share-btn" title="<%= t('stumble_share') %>">
        🔗 <span class="stumble-bar__label share-btn__label"><%= t('stumble_share') %></span>
      </button>

      <% if (!isGuest && user && user.isAdmin) { %>
      <button class="btn btn-reject btn-sm" id="admin-reject-btn"
              title="<%= t('stumble_admin_reject') %>">🗑</button>
      <% } %>

      <a href="/stumble" class="btn btn-primary btn-sm" title="Site suivant (Espace / →)"><%= t('stumble_next') %> →</a>
    </div>
  </div>

  <% if (isGuest) { %>
  <div class="stumble-guest-banner">
    <span><%- t('guest_banner', { count: guestCount, limit: guestLimit }) %></span>
    <a href="/signup" class="btn btn-primary btn-sm"><%= t('guest_banner_cta') %></a>
    <a href="/login" class="btn btn-ghost btn-sm"><%= t('nav_login') %></a>
  </div>
  <% } %>

  <% if (flashLessOfThis) { %>
    <div class="stumble-flash" id="stumble-flash"><%= t('stumble_less_done') %></div>
  <% } %>

  <!-- ── Iframe (uniquement si can_embed != false) ────────────────────── -->
  <% if (canEmbed) { %>
  <iframe
    src="<%= site.url %>"
    class="stumble-iframe"
    id="stumble-iframe"
    title="<%= site.title %>"
    sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
  ></iframe>
  <% } %>

  <!-- ── Carte fallback ───────────────────────────────────────────────── -->
  <div class="stumble-card-wrap" id="stumble-card-wrap"
       style="<%= canEmbed ? 'display:none' : 'display:flex' %>">
    <div class="stumble-card">
      <div class="stumble-meta">
        <% categories.forEach(cat => { %>
          <span class="stumble-tag"><%= cat.emoji %> <%= cat.localName %></span>
        <% }) %>
      </div>
      <h1 class="stumble-title"><%= site.title %></h1>
      <p class="stumble-desc"><%= site.description %></p>
      <p class="stumble-url"><%= hostname %></p>
      <div class="stumble-actions">
        <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer"
           class="btn btn-primary btn-large">
          <%= t('stumble_open_tab') %> ↗
        </a>
        <a href="/stumble" class="btn btn-secondary btn-large">
          <%= t('stumble_next') %> →
        </a>
      </div>

      <details class="why-details" style="margin-top:1.5rem">
        <summary class="why-toggle"><%= t('stumble_why_title') %></summary>
        <div class="why-body">
          <div class="why-row">
            <span class="why-label"><%= t('stumble_why_categories') %></span>
            <span class="why-cats">
              <% const matchingCats = categories.filter(c => c.in_interests); %>
              <% (matchingCats.length ? matchingCats : categories).forEach(cat => { %>
                <span class="stumble-tag stumble-tag--why">
                  <%= cat.emoji %> <%= cat.localName %>
                  <% if (matchingCats.length) { %>
                    <span class="why-weight">×<%= parseFloat(cat.weight).toFixed(1) %></span>
                  <% } %>
                </span>
              <% }) %>
            </span>
          </div>
        </div>
      </details>
    </div>
  </div>

  <script>
    var CSRF    = document.querySelector('meta[name="csrf"]').getAttribute('content');
    var SITE_ID = '<%= site.id %>';
    var userVote = <%= userVote === null || userVote === undefined ? 'null' : userVote %>;
    var score    = <%= score %>;
    var ANIMATIONS = document.documentElement.classList.contains('sc-anim');

    // Navigation vers le site suivant (avec animation si activée)
    function navigateNext() {
      if (!ANIMATIONS) { window.location.href = '/stumble'; return; }
      var bar      = document.querySelector('.stumble-bar');
      var card     = document.querySelector('.stumble-card');
      var iframeEl = document.getElementById('stumble-iframe');
      var cWrap    = document.getElementById('stumble-card-wrap');
      var isCard   = !cWrap || cWrap.style.display !== 'none';
      var target   = isCard ? card : iframeEl;
      if (bar)    bar.style.animation    = 'sc-bar-out 200ms ease-in both';
      if (target) {
        target.style.transformOrigin = 'right center';
        target.style.animation = 'sc-flip-out 260ms cubic-bezier(0.4,0,0.2,1) both';
      }
      setTimeout(function() { window.location.href = '/stumble'; }, 280);
    }

    // ── Votes (fetch, pas de rechargement d'iframe) ────────────────────────
    function postVote(dir) {
      fetch('/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '_csrf=' + encodeURIComponent(CSRF) +
              '&site_id=' + SITE_ID + '&direction=' + dir,
      });
      if (userVote === dir) { score -= dir;  userVote = null; }
      else                  { if (userVote !== null) score -= userVote; score += dir; userVote = dir; }
      var up = document.getElementById('vote-up');
      var dn = document.getElementById('vote-down');
      var sc = document.getElementById('vote-score');
      up.classList.toggle('vote-btn--active', userVote === 1);
      dn.classList.toggle('vote-btn--active', userVote === -1);
      sc.textContent = (score > 0 ? '+' : '') + score;
      sc.className = 'vote-score' + (score > 0 ? ' vote-score--pos' : score < 0 ? ' vote-score--neg' : '');
    }
    document.getElementById('vote-up').addEventListener('click',  function() { postVote(1);  });
    document.getElementById('vote-down').addEventListener('click', function() { postVote(-1); });

    // ── Moins de ça ────────────────────────────────────────────────────────
    document.getElementById('less-btn').addEventListener('click', function() {
      fetch('/less-of-this', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '_csrf=' + encodeURIComponent(CSRF) + '&site_id=' + SITE_ID,
      }).then(function() { navigateNext(); });
    });

    // ── Rejet admin rapide ─────────────────────────────────────────────────
    var adminRejectBtn = document.getElementById('admin-reject-btn');
    if (adminRejectBtn) {
      adminRejectBtn.addEventListener('click', function() {
        if (!confirm('<%= t('stumble_admin_reject_confirm') %>')) return;
        fetch('/admin/site/' + SITE_ID + '/reject', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(CSRF),
        }).then(function() { navigateNext(); });
      });
    }

    // ── Interception des liens "Site suivant" ──────────────────────────────
    document.querySelectorAll('a[href="/stumble"]').forEach(function(a) {
      a.addEventListener('click', function(e) { e.preventDefault(); navigateNext(); });
    });

    // ── Détection du blocage iframe (X-Frame-Options → about:blank) ───────
    var iframe   = document.getElementById('stumble-iframe');
    var cardWrap = document.getElementById('stumble-card-wrap');

    if (iframe) {
      function showCard() {
        iframe.style.display   = 'none';
        cardWrap.style.display = 'flex';
      }

      iframe.addEventListener('load', function() {
        try {
          var loc = iframe.contentWindow.location.href;
          if (loc === 'about:blank') showCard();
        } catch (e) {
          // SecurityError → cross-origin → chargement réussi
        }
      });
    }

    // ── Partager ───────────────────────────────────────────────────────────
    var shareBtn   = document.getElementById('share-btn');
    var SHARE_URL  = window.location.origin + '/stumble/<%= site.id %>';
    var SHARE_TITLE = '<%= site.title.replace(/\\/g, "\\\\").replace(/'/g, "\\'") %>';

    if (shareBtn) {
      shareBtn.addEventListener('click', function () {
        if (navigator.share) {
          navigator.share({ title: SHARE_TITLE, url: SHARE_URL }).catch(function () {});
          return;
        }
        navigator.clipboard.writeText(SHARE_URL).then(function () {
          shareBtn.textContent = '✅';
          setTimeout(function () { shareBtn.innerHTML = '🔗 <span class="stumble-bar__label"><%= t('stumble_share') %></span>'; }, 2000);
        }).catch(function () {
          window.prompt('Copie ce lien :', SHARE_URL);
        });
      });
    }

    // ── Raccourcis clavier ─────────────────────────────────────────────────
    document.addEventListener('keydown', function(e) {
      var tag = document.activeElement ? document.activeElement.tagName : '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (e.ctrlKey || e.altKey || e.metaKey) return;
      switch (e.key) {
        case ' ':
        case 'ArrowRight':
          e.preventDefault();
          navigateNext();
          break;
        case 'l': case 'L':
          e.preventDefault();
          postVote(1);
          break;
        case 'd': case 'D':
          e.preventDefault();
          postVote(-1);
          break;
        case 'o': case 'O':
          e.preventDefault();
          window.open('<%= site.url %>', '_blank', 'noopener,noreferrer');
          break;
      }
    });

    // ── Flash auto-dismiss ─────────────────────────────────────────────────
    var flash = document.getElementById('stumble-flash');
    if (flash) setTimeout(function() {
      flash.style.transition = 'opacity 0.5s';
      flash.style.opacity    = '0';
      setTimeout(function() { flash.remove(); }, 500);
    }, 3000);
  </script>
</body>
</html>
