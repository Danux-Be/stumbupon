<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= currentLang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — StumbleClone</title>
  <link rel="icon" href="/icons/icon-192.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/icons/icon-512.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#5c6bc0" />
  <%
    var _ogDesc = locals.ogDescription || t('home_hero_desc');
    var _ogTitle = locals.ogTitle || (title === 'StumbleClone' ? 'StumbleClone' : title + ' — StumbleClone');
    var _ogImg = locals.ogImage || (baseUrl + '/icons/icon-512.svg');
  %>
  <meta name="description" content="<%= _ogDesc.slice(0, 160) %>" />
  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="StumbleClone" />
  <meta property="og:title" content="<%= _ogTitle %>" />
  <meta property="og:description" content="<%= _ogDesc.slice(0, 200) %>" />
  <meta property="og:image" content="<%= _ogImg %>" />
  <% if (locals.ogUrl) { %>
  <meta property="og:url" content="<%= ogUrl %>" />
  <link rel="canonical" href="<%= ogUrl %>" />
  <% } %>
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= _ogTitle %>" />
  <meta name="twitter:description" content="<%= _ogDesc.slice(0, 200) %>" />
  <meta name="twitter:image" content="<%= _ogImg %>" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= cssVersion %>" />
  <script>(function(){var t=localStorage.getItem('sc-theme');if(t==='dark')document.documentElement.classList.add('dark');else if(t==='light')document.documentElement.classList.add('light');}());</script>
  <script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
  <script src="/js/alpine.min.js" defer></script>
  <script defer src="https://analytics.danux.be/script.js" data-website-id="2bd358ed-ed44-4bb6-9ad8-ae9519f5067f"></script>
</head>
<body>
  <header class="site-header">
    <a href="/" class="logo">🌀 StumbleClone</a>
    <nav>
      <% if (locals.user) { %>
        <a href="/stumble" class="btn btn-primary btn-sm"><%= t('nav_stumble') %></a>

        <div class="nav-user-menu">
          <button class="nav-username-btn" id="nav-user-btn"
                  aria-haspopup="menu" aria-expanded="false">
            <%- t('nav_greeting', { name: `<strong>${user.username}</strong>` }) %>
            <span class="mdi mdi-chevron-down nav-chevron"></span>
          </button>
          <div class="nav-dropdown" role="menu">
            <a href="/favorites" class="nav-dropdown__item"><span class="mdi mdi-bookmark-outline"></span> <%= t('nav_favorites') %></a>
            <a href="/tastes" class="nav-dropdown__item"><span class="mdi mdi-tune-variant"></span> <%= t('nav_tastes') %></a>
            <a href="/submit" class="nav-dropdown__item"><span class="mdi mdi-plus"></span> <%= t('nav_submit') %></a>
            <a href="/settings" class="nav-dropdown__item"><span class="mdi mdi-cog-outline"></span> <%= t('settings_title') %></a>
            <% if (user.isAdmin) { %>
              <div class="nav-dropdown__divider"></div>
              <a href="/admin" class="nav-dropdown__item nav-dropdown__item--admin"><span class="mdi mdi-wrench-outline"></span> Admin</a>
            <% } %>
            <div class="nav-dropdown__divider"></div>
            <form method="POST" action="/logout">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>" />
              <button type="submit" class="nav-dropdown__item nav-dropdown__item--logout">
                <span class="mdi mdi-logout"></span> <%= t('nav_logout') %>
              </button>
            </form>
          </div>
        </div>

      <% } else { %>
        <a href="/login"><%= t('nav_login') %></a>
        <a href="/signup" class="btn btn-primary"><%= t('nav_signup') %></a>
      <% } %>

      <a href="/search" class="nav-search-btn" title="<%= t('search_title') %>" aria-label="<%= t('search_title') %>"><span class="mdi mdi-magnify"></span></a>

      <button id="theme-toggle" class="theme-toggle" title="Changer de thème" aria-label="Changer de thème"><span class="mdi mdi-theme-light-dark"></span></button>
    </nav>
  </header>
  <main>
