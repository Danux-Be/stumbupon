<%- include('partials/header', { title }) %>

<div class="interests-page">
  <div class="interests-header">
    <h1>Tes centres d'intérêt</h1>
    <p>Choisis au moins <strong>3 thèmes</strong> pour personnaliser tes découvertes.</p>
  </div>

  <% if (error) { %>
    <p class="form-error interests-error"><%= error %></p>
  <% } %>

  <form method="POST" action="/interests" x-data="{ count: <%= selected.length %> }">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <p class="interests-count" x-text="`${count} sélectionné${count > 1 ? 's' : ''}`"></p>

    <div class="categories-grid">
      <% for (const cat of categories) { %>
        <label class="category-card" x-on:click="count = $el.querySelector('input').checked ? count - 1 : count + 1">
          <input
            type="checkbox"
            name="categories"
            value="<%= cat.id %>"
            <%= selected.includes(cat.id) ? 'checked' : '' %>
          />
          <span class="category-emoji"><%= cat.emoji %></span>
          <span class="category-name"><%= cat.name %></span>
        </label>
      <% } %>
    </div>

    <div class="interests-actions">
      <button type="submit" class="btn btn-primary btn-large" x-bind:disabled="count < 3">
        Enregistrer mes choix
      </button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
