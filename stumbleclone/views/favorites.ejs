<%- include('partials/header') %>

<div class="favorites-page">
  <div class="favorites-header">
    <h1><%= t('favorites_title') %></h1>
    <% if (total > 0) { %>
      <p class="favorites-count"><%- t('favorites_count', { count: total }) %></p>
    <% } %>
  </div>

  <% if (sites.length === 0) { %>
    <div class="favorites-empty">
      <p><%= t('favorites_empty') %></p>
      <a href="/stumble" class="btn btn-primary"><%= t('nav_stumble') %></a>
    </div>
  <% } else { %>
    <div class="favorites-list">
      <% sites.forEach(site => { %>
        <div class="fav-card">
          <div class="fav-meta">
            <% (catsBySite[site.id] || []).forEach(cat => { %>
              <span class="stumble-tag"><%= cat.emoji %> <%= cat.localName %></span>
            <% }) %>
          </div>
          <h2 class="fav-title">
            <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer"><%= site.title %></a>
          </h2>
          <% if (site.description) { %>
            <p class="fav-desc"><%= site.description %></p>
          <% } %>
          <div class="fav-actions">
            <a href="<%= site.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
              <%= t('stumble_visit') %> →
            </a>
            <a href="/stumble/<%= site.id %>" class="btn btn-secondary btn-sm">
              <%= t('favorites_see_card') %>
            </a>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <nav class="pagination">
        <% if (page > 1) { %>
          <a href="/favorites?page=<%= page - 1 %>" class="btn btn-secondary btn-sm">← <%= t('pagination_prev') %></a>
        <% } %>
        <span class="pagination-info"><%= page %> / <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/favorites?page=<%= page + 1 %>" class="btn btn-secondary btn-sm"><%= t('pagination_next') %> →</a>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
