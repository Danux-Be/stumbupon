<%- include('partials/header', { title: t('reset_title') }) %>

<div class="form-page">
  <div class="form-card">
    <h1><%= t('reset_title') %></h1>

    <% if (invalid) { %>
      <p class="alert alert-error"><%= t('reset_invalid') %></p>
      <p class="form-footer"><a href="/forgot-password"><%= t('forgot_title') %></a></p>
    <% } else if (success) { %>
      <p class="alert alert-success"><%= t('reset_success') %></p>
      <p class="form-footer"><a href="/login"><%= t('login_submit') %></a></p>
    <% } else { %>
      <% if (error) { %>
        <p class="form-error"><%= error %></p>
      <% } %>

      <form method="POST" action="/reset-password/<%= token %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="form-group">
          <label for="newpass"><%= t('settings_password_new') %></label>
          <input type="password" id="newpass" name="newpass" required minlength="8"
                 autocomplete="new-password" />
          <span class="form-hint"><%= t('settings_password_hint') %></span>
        </div>

        <div class="form-group">
          <label for="confirm"><%= t('settings_password_confirm') %></label>
          <input type="password" id="confirm" name="confirm" required minlength="8"
                 autocomplete="new-password" />
        </div>

        <button type="submit" class="btn btn-primary btn-block"><%= t('reset_submit') %></button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
