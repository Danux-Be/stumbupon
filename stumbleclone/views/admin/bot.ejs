<%- include('../partials/header') %>

<div class="admin-page">
  <div class="admin-page-header">
    <a href="/admin" class="admin-back">← <%= t('admin_title') %></a>
    <h1>🤖 <%= t('admin_bot_title') %></h1>
  </div>

  <% if (launched) { %>
    <div class="alert alert--success" style="margin-bottom:1.5rem">✅ <%= t('admin_bot_launched') %></div>
  <% } %>
  <% if (alreadyRunning) { %>
    <div class="alert alert--warn" style="margin-bottom:1.5rem">⚠️ <%= t('admin_bot_already_running') %></div>
  <% } %>

  <%# ── Formulaire de lancement ── %>
  <div class="settings-section" style="margin-bottom:2rem">
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1rem;flex-wrap:wrap">
      <h2 style="margin:0"><%= t('admin_bot_run_title') %></h2>
      <span class="risk-badge risk-badge--<%= botRunning ? 'high' : 'low' %>">
        <%= botRunning ? '⚙️ ' + t('admin_bot_running') : '⏸ ' + t('admin_bot_idle') %>
      </span>
    </div>

    <form method="POST" action="/admin/bot/run" style="display:flex;flex-wrap:wrap;gap:0.8rem;align-items:flex-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div style="display:flex;flex-direction:column;gap:0.3rem">
        <label style="font-size:0.85rem;color:var(--color-text-muted)"><%= t('admin_bot_source') %></label>
        <select name="source" class="form-input" style="min-width:150px">
          <% ['all','crawler','hn','wiby','lobsters','reddit','marginalia','github','neocities','pinboard','metafilter','tildes','kbclub','searchmysite'].forEach(src => { %>
            <option value="<%= src %>"><%= src %></option>
          <% }) %>
        </select>
      </div>

      <div style="display:flex;flex-direction:column;gap:0.3rem">
        <label style="font-size:0.85rem;color:var(--color-text-muted)"><%= t('admin_bot_limit') %></label>
        <input type="number" name="limit" value="20" min="1" max="200" class="form-input" style="width:90px" />
      </div>

      <div style="display:flex;flex-direction:column;gap:0.3rem">
        <label style="font-size:0.85rem;color:var(--color-text-muted)"><%= t('admin_bot_seeds') %></label>
        <input type="number" name="seeds" value="5" min="1" max="20" class="form-input" style="width:80px" />
      </div>

      <button type="submit" class="btn btn-primary" <%= botRunning ? 'disabled' : '' %>>
        🚀 <%= t('admin_bot_run_btn') %>
      </button>
    </form>
  </div>

  <%# ── Log ── %>
  <% if (logLines.length > 0) { %>
    <div class="settings-section" style="margin-bottom:2rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.8rem">
        <h2 style="margin:0"><%= t('admin_bot_log_title') %></h2>
        <% if (botRunning) { %>
          <a href="/admin/bot" class="btn btn-secondary" style="font-size:0.8rem">🔄 Rafraîchir</a>
        <% } %>
      </div>
      <div class="bot-log" style="max-height:300px;overflow-y:auto;font-size:0.78rem">
        <% logLines.forEach(line => { %>
          <div class="bot-log-row bot-log-row--<%= line.includes('✅') || line.includes('approved') ? 'approved' : line.includes('❌') || line.includes('rejected') ? 'rejected' : 'pending' %>">
            <%= line %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <%# ── Stats par source ── %>
  <% if (sourceStats.length > 0) { %>
    <h2 style="margin-bottom:1rem"><%= t('admin_bot_stats_title') %></h2>
    <div class="admin-stats" style="margin-bottom:2rem">
      <% sourceStats.forEach(s => { %>
        <div class="stat-card" style="text-align:left;min-width:200px">
          <span class="stat-value" style="font-size:1.2rem">🤖 <%= s.source %></span>
          <div style="font-size:0.85rem;color:var(--color-text-muted);margin-top:0.5rem;display:flex;flex-direction:column;gap:0.2rem">
            <span>✅ <%= s.approved %> approuvés</span>
            <span>⏳ <%= s.pending %> en attente</span>
            <span>❌ <%= s.rejected %> rejetés</span>
            <span style="margin-top:0.3rem;opacity:0.7">
              Dernière exécution : <%= new Date(s.last_run).toLocaleString() %>
            </span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <%# ── Dernières URL traitées ── %>
  <% if (recent.length > 0) { %>
    <h2 style="margin-bottom:1rem"><%= t('admin_bot_recent_title') %></h2>
    <div class="bot-log">
      <% recent.forEach(r => { %>
        <div class="bot-log-row bot-log-row--<%= r.status %>">
          <span class="bot-log-status">
            <%= r.status === 'approved' ? '✅' : r.status === 'pending' ? '⏳' : '❌' %>
          </span>
          <a href="<%= r.url %>" target="_blank" rel="noopener noreferrer" class="bot-log-url">
            <%= r.url.slice(0, 80) %><%= r.url.length > 80 ? '…' : '' %>
          </a>
          <span class="bot-log-score"><%= r.score !== null ? r.score + '/100' : '' %></span>
          <span class="bot-log-source"><%= r.source %></span>
          <span class="bot-log-date"><%= new Date(r.processed_at).toLocaleDateString() %></span>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="favorites-empty">
      <p><%= t('admin_bot_empty') %></p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
