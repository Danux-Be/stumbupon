<%- include('../partials/header') %>

<div class="admin-page">
  <h1><%= t('admin_users_title') %></h1>
  <a href="/admin" class="btn btn-secondary" style="margin-bottom:1.5rem"><span class="mdi mdi-arrow-left"></span> <%= t('admin_back') %></a>

  <% if (!users.length) { %>
    <p class="alert alert-info"><%= t('admin_users_empty') %></p>
  <% } else { %>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th><%= t('admin_users_col_user') %></th>
          <th><%= t('admin_users_col_email') %></th>
          <th><%= t('admin_users_col_joined') %></th>
          <th><%= t('admin_users_col_sites') %></th>
          <th><%= t('admin_users_col_votes') %></th>
          <th><%= t('admin_users_col_actions') %></th>
        </tr>
      </thead>
      <tbody>
        <% for (const u of users) { %>
        <tr class="<%= u.is_banned ? 'admin-table__row--banned' : '' %>">
          <td>
            <strong><%= u.username %></strong>
            <% if (u.is_admin) { %>
              <span class="user-badge user-badge--admin">admin</span>
            <% } %>
            <% if (u.is_banned) { %>
              <span class="user-badge user-badge--banned"><%= t('admin_badge_banned') %></span>
            <% } %>
            <% if (!u.email_verified) { %>
              <span class="user-badge user-badge--unverified"><%= t('admin_badge_unverified') %></span>
            <% } %>
          </td>
          <td class="admin-table__muted"><%= u.email %></td>
          <td class="admin-table__muted"><%= new Date(u.created_at).toLocaleDateString() %></td>
          <td><%= u.site_count %></td>
          <td><%= u.vote_count %></td>
          <td class="admin-table__actions">
            <% if (u.id !== currentUserId) { %>
              <% if (u.is_banned) { %>
                <form method="POST" action="/admin/users/<%= u.id %>/unban" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-approve btn-sm"><%= t('admin_unban') %></button>
                </form>
              <% } else { %>
                <form method="POST" action="/admin/users/<%= u.id %>/ban" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-reject btn-sm"><%= t('admin_ban') %></button>
                </form>
              <% } %>
              <% if (u.is_admin) { %>
                <form method="POST" action="/admin/users/<%= u.id %>/demote" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-secondary btn-sm"><%= t('admin_demote') %></button>
                </form>
              <% } else { %>
                <form method="POST" action="/admin/users/<%= u.id %>/promote" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn-secondary btn-sm"><%= t('admin_promote') %></button>
                </form>
              <% } %>
            <% } else { %>
              <span class="admin-table__muted">(vous)</span>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
