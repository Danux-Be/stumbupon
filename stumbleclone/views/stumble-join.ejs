<%- include('partials/header', { title: 'Rejoins StumbleClone' }) %>

<div class="stumble-join">
  <div class="stumble-join__inner">

    <!-- Compteur -->
    <div class="stumble-join__stat">
      <span class="stumble-join__stat-number"><%= guestLimit %></span>
      <span class="stumble-join__stat-label"><%= t('guest_join_stat') %></span>
    </div>

    <h1 class="stumble-join__title"><%- t('guest_join_title', { limit: guestLimit }) %></h1>
    <p class="stumble-join__desc"><%- t('guest_join_desc') %></p>

    <!-- Grille des avantages -->
    <div class="stumble-join__grid">

      <div class="stumble-join__card">
        <span class="mdi mdi-target stumble-join__card-icon"></span>
        <div>
          <strong>Recommandations sur mesure</strong>
          <p>Plus tu explores, mieux StumbleClone te connaît. Tes découvertes s'affinent selon tes intérêts.</p>
        </div>
      </div>

      <div class="stumble-join__card">
        <span class="mdi mdi-thumb-up stumble-join__card-icon"></span>
        <div>
          <strong>Vote et influence</strong>
          <p>Upvote ce que tu adores, downvote ce qui ne te parle pas. Chaque vote affine tes recommandations.</p>
        </div>
      </div>

      <div class="stumble-join__card">
        <span class="mdi mdi-bookmark-outline stumble-join__card-icon"></span>
        <div>
          <strong>Favoris illimités</strong>
          <p>Sauvegarde tes coups de cœur et retrouve-les à tout moment dans ta liste personnelle.</p>
        </div>
      </div>

      <div class="stumble-join__card">
        <span class="mdi mdi-comment-outline stumble-join__card-icon"></span>
        <div>
          <strong>Commentaires</strong>
          <p>Réagis, partage ton avis et échange avec la communauté sur chaque site découvert.</p>
        </div>
      </div>

      <div class="stumble-join__card">
        <span class="mdi mdi-translate stumble-join__card-icon"></span>
        <div>
          <strong>Filtre par langue</strong>
          <p>Explore le web uniquement dans les langues que tu choisis : français, anglais, et bien d'autres.</p>
        </div>
      </div>

      <div class="stumble-join__card">
        <span class="mdi mdi-account-group-outline stumble-join__card-icon"></span>
        <div>
          <strong>Recommandations collaboratives</strong>
          <p>Profite des goûts d'autres membres qui partagent tes centres d'intérêt.</p>
        </div>
      </div>

      <div class="stumble-join__card">
        <span class="mdi mdi-plus-circle-outline stumble-join__card-icon"></span>
        <div>
          <strong>Soumets des sites</strong>
          <p>Contribue à la communauté en partageant tes propres découvertes avec tout le monde.</p>
        </div>
      </div>

      <div class="stumble-join__card">
        <span class="mdi mdi-tune-variant stumble-join__card-icon"></span>
        <div>
          <strong>Interface personnalisée</strong>
          <p>Thème clair ou sombre, position de la barre, animations — tout est réglable selon tes préférences.</p>
        </div>
      </div>

    </div>

    <!-- CTA -->
    <div class="stumble-join__actions">
      <a href="/signup" class="btn btn-primary btn-large">
        <span class="mdi mdi-account-plus-outline"></span> <%= t('guest_join_signup') %>
      </a>
      <a href="/login" class="btn btn-secondary btn-large">
        <span class="mdi mdi-login"></span> <%= t('guest_join_login') %>
      </a>
    </div>

    <p class="stumble-join__fine">Gratuit · Sans carte bancaire · Sans engagement</p>

    <a href="/stumble/join/skip" class="btn btn-ghost btn-large stumble-join__skip-btn">
      <%= t('stumble_next') %> <span class="mdi mdi-arrow-right"></span>
    </a>

  </div>
</div>

<a href="/stumble/join/skip" class="stumble-mobile-next">
  <%= t('stumble_next') %> <span class="mdi mdi-arrow-right"></span>
</a>

<%- include('partials/footer') %>
